{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/plangraph/hosts.schema.json",
  "description": "OS-specific path absoluteness and filesystem containment are enforced only by Rust. Rust also accepts an explicit null python as absent.",
  "title": "plangraph host registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "self", "hosts"],
  "properties": {
    "version": { "const": 1 },
    "self": { "type": "string", "minLength": 1 },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/hostEntry" }
    }
  },
  "$defs": {
    "hostEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "aliases", "transport", "os", "state_dir", "caps", "warmup", "session_mb", "roles", "repos"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "class": { "enum": ["worker", "restricted"], "default": "worker", "description": "Policy label; restricted cap bounds are enforced by Rust." },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "transport": { "enum": ["local", "keeper", "ssh"] },
        "os": { "enum": ["linux", "windows"] },
        "state_dir": { "type": "string", "minLength": 1 },
        "caps": { "$ref": "#/$defs/caps" },
        "warmup": { "$ref": "#/$defs/warmup" },
        "session_mb": { "type": "integer", "minimum": 1 },
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/role" }
        },
        "repos": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
          "additionalProperties": { "$ref": "#/$defs/repoEntry" }
        }
      }
    },
    "role": { "enum": ["implement", "review", "research", "orchestrate", "session"] },
    "caps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_runs", "max_writers", "max_seats", "max_sessions", "mem_floor_mb"],
      "properties": {
        "max_runs": { "type": "integer", "minimum": 1 },
        "max_writers": { "type": "integer", "minimum": 0 },
        "max_seats": { "type": "integer", "minimum": 0 },
        "max_sessions": { "type": "integer", "minimum": 0 },
        "mem_floor_mb": { "type": "integer", "minimum": 0 }
      }
    },
    "warmup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warmup_s", "ramp_mb"],
      "properties": {
        "warmup_s": { "type": "integer", "minimum": 1 },
        "ramp_mb": {
          "type": "object",
          "propertyNames": { "enum": ["implement", "review", "research", "orchestrate", "session"] },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "repoEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "worktrees_root", "remote", "import_roots", "cache_env"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "live_dir": { "type": "string", "minLength": 1 },
        "health_checks": {
          "type": "object", "additionalProperties": false,
          "required": ["doctor", "whoami", "spawn"],
          "properties": {
            "doctor": { "$ref": "#/$defs/command" },
            "whoami": { "$ref": "#/$defs/command" },
            "spawn": { "$ref": "#/$defs/command" }
          }
        },
        "worktrees_root": { "type": "string", "minLength": 1 },
        "remote": { "type": "string", "minLength": 1 },
        "python": { "type": ["string", "null"], "minLength": 1 },
        "import_roots": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?![/\\\\]|[A-Za-z]:)",
            "not": { "pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)" }
          }
        },
        "cache_env": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
