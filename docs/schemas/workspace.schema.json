{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plangraph card workspace",
  "description": "Contract D6 (plan rev 6.4): a card carries no paths, only repo_id, mode and revisions. writer base_sha == revision_sha is cross-field equality, enforced in rust/worker-core/src/workspace.rs and noted here for readers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["repo_id", "mode"],
  "properties": {
    "repo_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "mode": {"enum": ["writer", "seat", "read", "none"]},
    "base_sha": {"$ref": "#/$defs/sha"},
    "revision_sha": {"$ref": "#/$defs/sha"},
    "branch": {"type": "string", "maxLength": 200, "description": "writer only: lane/<name> following git ref rules after lane/; never a default branch name", "allOf": [
      {"pattern": "^lane/.+"},
      {"not": {"pattern": "\\.\\."}},
      {"not": {"pattern": "//"}},
      {"not": {"pattern": "@\\{"}},
      {"not": {"pattern": "[\\x00-\\x20\\x7f]"}},
      {"not": {"pattern": "[~^:?*\\[\\\\]"}},
      {"not": {"pattern": "(^|/)\\.|(/|\\.)$"}},
      {"not": {"pattern": "(^|/)[^/]*\\.lock(/|$)"}}
    ]}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$", "description": "exactly 40 lowercase hex characters; no short, uppercase or longer values"}
  },
  "allOf": [
    {"if": {"properties": {"mode": {"const": "writer"}}, "required": ["mode"]}, "then": {"required": ["base_sha", "revision_sha", "branch"]}},
    {"if": {"properties": {"mode": {"const": "seat"}}, "required": ["mode"]}, "then": {"required": ["base_sha", "revision_sha"], "not": {"required": ["branch"]}}},
    {"if": {"properties": {"mode": {"const": "read"}}, "required": ["mode"]}, "then": {"required": ["revision_sha"], "not": {"required": ["branch"]}}},
    {"if": {"properties": {"mode": {"const": "none"}}, "required": ["mode"]}, "then": {"not": {"anyOf": [{"required": ["base_sha"]}, {"required": ["revision_sha"]}, {"required": ["branch"]}]}}}
  ]
}
