{
  "version": 1,
  "self": "code",
  "hosts": [
    {
      "id": "code",
      "class": "worker",
      "aliases": ["devbox"],
      "transport": "ssh",
      "ssh_target": "linux-worker.example.invalid",
      "env": { "PATH": "/opt/fleet/bin:/usr/bin:/bin" },
      "os": "linux",
      "state_dir": "/srv/fleet/code/state",
      "caps": {
        "max_runs": 10,
        "max_writers": 8,
        "max_seats": 3,
        "max_sessions": 8,
        "mem_floor_mb": 4096
      },
      "warmup": {
        "warmup_s": 30,
        "ramp_mb": { "implement": 256, "session": 128 }
      },
      "session_mb": 2048,
      "roles": ["implement", "review", "research", "orchestrate", "session"],
      "repos": {
        "plangraph": {
          "root": "/srv/fleet/code/repos/plangraph",
          "live_dir": "/srv/fleet/live/plangraph/current",
          "health_checks": {
            "doctor": ["python3", "-m", "plangraph.spawner", "doctor"],
            "whoami": ["pg", "keeper", "whoami"],
            "spawn": ["python3", "-m", "plangraph.spawner", "spawn", "--dry-run"]
          },
          "worktrees_root": "/srv/fleet/code/worktrees/plangraph",
          "remote": "git@placeholder.invalid:fleet/plangraph.git",
          "python": "/srv/fleet/venvs/plangraph/bin/python",
          "import_roots": ["rust", "docs"],
          "cache_env": {
            "PG_CACHE": "/srv/fleet/cache/%SLOT%",
            "PG_INDEX": "/srv/fleet/index"
          }
        }
      }
    },
    {
      "id": "workstation",
      "class": "worker",
      "aliases": ["winbox"],
      "transport": "ssh",
      "ssh_target": "worker.example.invalid",
      "os": "windows",
      "state_dir": "C:\\fleet\\workstation\\state",
      "caps": {
        "max_runs": 12,
        "max_writers": 8,
        "max_seats": 2,
        "max_sessions": 4,
        "mem_floor_mb": 8192
      },
      "warmup": {
        "warmup_s": 45,
        "ramp_mb": { "implement": 512, "session": 256 }
      },
      "session_mb": 4096,
      "roles": ["implement", "session"],
      "repos": {
        "plangraph": {
          "root": "C:\\fleet\\workstation\\repos\\plangraph",
          "worktrees_root": "C:\\fleet\\workstation\\worktrees\\plangraph",
          "remote": "git@placeholder.invalid:fleet/plangraph.git",
          "python": "C:\\fleet\\venvs\\plangraph\\Scripts\\python.exe",
          "import_roots": ["rust", "docs"],
          "cache_env": {
            "PG_CACHE": "C:\\fleet\\cache\\%SLOT%",
            "PG_INDEX": "C:\\fleet\\index"
          }
        }
      }
    },
    {
      "id": "compact",
      "class": "worker",
      "aliases": [],
      "transport": "ssh",
      "os": "linux",
      "state_dir": "/srv/fleet/compact/state",
      "caps": {
        "max_runs": 3,
        "max_writers": 2,
        "max_seats": 2,
        "max_sessions": 4,
        "mem_floor_mb": 2048
      },
      "warmup": {
        "warmup_s": 30,
        "ramp_mb": {
          "implement": 256
        }
      },
      "session_mb": 2048,
      "roles": [
        "implement"
      ],
      "repos": {}
    }
  ]
}
