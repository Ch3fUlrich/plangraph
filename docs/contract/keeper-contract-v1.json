{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/plangraph/keeper-contract-v1.json",
  "title": "plangraph keeper HTTP contract",
  "contract_version": "1.0",
  "prefix": "/v1",
  "auth": {"scheme": "Authorization: Bearer <token>", "open_routes": ["GET /v1/health"], "missing_or_unknown_token": {"status": 401, "error": "forbidden"}},
  "error_status": {"validation": 400, "bad_state": 400, "evidence_missing": 400, "evidence_unverified": 400, "family_unknown": 400, "cycle": 400, "too_large": 413, "forbidden": 403, "not_found": 404, "method_not_allowed": 405, "conflict": 409, "locked": 409, "epoch_stale": 409, "lease_held": 409, "same_principal": 409, "same_family": 409, "internal": 500},
  "routes": [
    {"method": "GET", "path": "/v1/health", "roles": "none", "response": "Health"},
    {"method": "GET", "path": "/v1/whoami", "roles": "any", "response": "WhoAmI"},
    {"method": "GET", "path": "/v1/ready", "roles": "any", "response": "Ready", "query": ["fmt", "project", "n", "all", "mine", "agent", "owner"], "text_default": true},
    {"method": "GET", "path": "/v1/show", "roles": "any", "response": "Show", "query": ["fmt", "key", "brief"], "text_default": true, "note": "also GET /v1/show/<key>; brief=1 returns Brief"},
    {"method": "GET", "path": "/v1/blocked", "roles": "any", "response": "Blocked", "query": ["fmt", "project"], "text_default": true},
    {"method": "GET", "path": "/v1/waves", "roles": "any", "response": "Waves", "query": ["fmt"]},
    {"method": "GET", "path": "/v1/critical_path", "roles": "any", "response": "CriticalPath", "query": ["fmt", "project"]},
    {"method": "GET", "path": "/v1/percent", "roles": "any", "response": "Percent", "query": ["fmt", "project", "by"]},
    {"method": "GET", "path": "/v1/alerts", "roles": "any", "response": "Alerts", "query": ["fmt", "project"], "text_default": true},
    {"method": "GET", "path": "/v1/digest", "roles": ["router"], "response": "Digest", "query": ["fmt"]},
    {"method": "GET", "path": "/v1/snapshot", "roles": "any", "response": "Snapshot", "query": ["fmt"]},
    {"method": "GET", "path": "/v1/aliases", "roles": "any", "response": "Aliases", "query": ["fmt"], "text_default": true},
    {"method": "GET", "path": "/v1/needs_you", "roles": "any", "response": "NeedsYou", "query": ["fmt", "project"]},
    {"method": "GET", "path": "/v1/answers", "roles": "any", "response": "Answers", "query": ["fmt", "project"]},
    {"method": "GET", "path": "/v1/progress", "roles": "any", "response": "Progress", "query": ["fmt", "project"]},
    {"method": "GET", "path": "/v1/changelog", "roles": "any", "response": "Changelog", "query": ["fmt", "since"], "text_default": true},
    {"method": "GET", "path": "/v1/audit-meta", "roles": ["router", "l1"], "response": "AuditMeta", "query": ["fmt", "project", "stale_days"], "text_default": true},
    {"method": "POST", "path": "/v1/create_items", "roles": ["router", "l1"], "request": "CreateItems", "response": "Created", "note": "l1: own projects only"},
    {"method": "POST", "path": "/v1/import_items", "roles": ["router"], "request": "CreateItems", "response": "Created", "note": "honours state open|claimed|in_review"},
    {"method": "POST", "path": "/v1/edit_definition", "roles": ["router", "l1"], "request": "EditDefinition", "response": "KeyOnly", "note": "l1: own projects; open items only"},
    {"method": "POST", "path": "/v1/set_priority", "roles": ["router"], "request": "SetPriority", "response": "Priority"},
    {"method": "POST", "path": "/v1/claim", "roles": ["l1", "worker"], "request": "ClaimBody", "response": "Claim"},
    {"method": "POST", "path": "/v1/delegate", "roles": ["claimant"], "request": "DelegateBody", "response": "Delegate"},
    {"method": "POST", "path": "/v1/heartbeat", "roles": ["claimant", "delegate", "run_token_writer"], "request": "Fenced", "response": "Claim"},
    {"method": "POST", "path": "/v1/release", "roles": ["claimant", "router"], "request": "Fenced", "response": "KeyOnly"},
    {"method": "POST", "path": "/v1/add_evidence", "roles": ["claimant", "delegate", "run_token_writer"], "request": "AddEvidence", "response": "Evidence"},
    {"method": "POST", "path": "/v1/add_evidence_router", "roles": ["router"], "request": "AddEvidenceRouter", "response": "Evidence"},
    {"method": "POST", "path": "/v1/submit", "roles": ["claimant", "delegate", "run_token_writer"], "request": "Fenced", "response": "Submit"},
    {"method": "POST", "path": "/v1/verdict", "roles": ["reviewer", "run_token_reviewer"], "request": "VerdictBody", "response": "Verdict"},
    {"method": "POST", "path": "/v1/cancel", "roles": ["router", "l1"], "request": "CancelBody", "response": "Cancel", "note": "l1: own projects; refused while active dependents exist"},
    {"method": "POST", "path": "/v1/reap", "roles": ["system"], "request": "Empty", "response": "Reap", "note": "no token of another role may call it"},
    {"method": "POST", "path": "/v1/waive_second_family", "roles": ["router"], "request": "WaiveBody", "response": "Waive"},
    {"method": "POST", "path": "/v1/close_on_decision", "roles": ["router"], "request": "CloseBody", "response": "Close"},
    {"method": "POST", "path": "/v1/set_legacy_state", "roles": ["router"], "request": "LegacyBody", "response": "Legacy"},
    {"method": "POST", "path": "/v1/apply_ops", "roles": ["router"], "request": "ApplyOpsBody", "response": "ApplyOps"},
    {"method": "POST", "path": "/v1/migrate_descriptions", "roles": ["router"], "request": "Empty", "response": "Migrate"},
    {"method": "POST", "path": "/v1/rehome", "roles": ["router"], "request": "RehomeBody", "response": "Rehome"},
    {"method": "POST", "path": "/v1/record_run", "roles": ["spawner"], "request": "RecordRunBody", "response": "RecordRun"},
    {"method": "POST", "path": "/v1/answer", "roles": ["router"], "request": "AnswerBody", "response": "Answer"},
    {"method": "POST", "path": "/v1/mint_run_token", "roles": ["router", "l1"], "request": "MintBody", "response": "MintToken"},
    {"method": "POST", "path": "/v1/replay", "roles": ["run_token"], "request": "ReplayBody", "response": "Replay"},
    {"method": "POST", "path": "/v1/withdraw_review", "roles": ["router"], "request": "WithdrawBody", "response": "Withdraw"},
    {"method": "POST", "path": "/v1/reopen", "roles": ["router"], "request": "ReopenBody", "response": "Reopen"},
    {"method": "POST", "path": "/v1/set_kind", "roles": ["router"], "request": "SetKindBody", "response": "SetKind"}
  ],
  "$defs": {
    "Error": {"type": "object", "properties": {"error": {"enum": ["validation", "forbidden", "not_found", "method_not_allowed", "too_large", "bad_state", "conflict", "locked", "epoch_stale", "lease_held", "same_principal", "same_family", "family_unknown", "evidence_missing", "evidence_unverified", "cycle", "internal"]}, "msg": {"type": "string"}}, "required": ["error", "msg"]},
    "Health": {"type": "object", "properties": {"status": {"const": "ok"}}, "required": ["status"]},
    "WhoAmI": {"type": "object", "properties": {"name": {"type": "string"}, "role": {"enum": ["router", "l1", "worker", "reviewer", "system", "reader", "spawner"]}, "projects": {"type": "array", "items": {"type": "string"}}, "family": {"type": ["string", "null"]}}, "required": ["name", "role", "projects", "family"]},
    "Item": {"type": "object", "properties": {"key": {"type": "string"}, "project": {"type": "string"}, "id": {"type": "string"}, "title": {"type": "string"}, "kind": {"enum": ["lane", "gate", "goal", "question", "decision", "operator_task"]}, "state": {"enum": ["open", "claimed", "in_review", "done", "cancelled"]}, "epoch": {"type": "integer"}, "round": {"type": "integer"}, "priority": {"type": "integer"}, "depends_on": {"type": "array", "items": {"type": "string"}}, "evidence_kinds": {"type": "array", "items": {"type": "string"}}, "review_tier": {"enum": ["standard", "high", "none"]}, "claimed_by": {"type": ["string", "null"]}, "delegate": {"type": ["string", "null"]}, "lease_until": {"type": ["string", "null"]}, "reviewer": {"type": ["string", "null"]}, "operator": {"type": "boolean"}, "owner": {"type": ["string", "null"]}, "track": {"type": ["string", "null"]}, "done_criteria": {"type": ["string", "null"]}, "description": {"type": ["string", "null"]}, "host": {"type": ["string", "null"]}, "wait": {"type": ["string", "null"]}, "estimate_h": {"type": ["number", "null"]}, "corrects": {"type": ["string", "null"]}, "fixes": {"type": ["string", "null"]}, "note": {"type": ["string", "null"]}}, "required": ["key", "project", "id", "title", "kind", "state", "epoch", "priority", "depends_on", "evidence_kinds", "review_tier", "claimed_by", "lease_until", "operator"]},
    "Ready": {"type": "object", "properties": {"items": {"type": "array", "items": {"$ref": "#/$defs/Item"}}, "unblocks": {"type": "object", "additionalProperties": {"type": "integer"}}}, "required": ["items", "unblocks"]},
    "Dep": {"type": "object", "properties": {"key": {"type": "string"}, "state": {"type": ["string", "null"]}}, "required": ["key", "state"]},
    "Show": {"type": "object", "properties": {"key": {"type": "string"}, "project": {"type": "string"}, "id": {"type": "string"}, "title": {"type": "string"}, "kind": {"enum": ["lane", "gate", "goal", "question", "decision", "operator_task"]}, "state": {"enum": ["open", "claimed", "in_review", "done", "cancelled"]}, "epoch": {"type": "integer"}, "round": {"type": "integer"}, "priority": {"type": "integer"}, "depends_on": {"type": "array", "items": {"$ref": "#/$defs/Dep"}}, "evidence_kinds": {"type": "array", "items": {"type": "string"}}, "review_tier": {"enum": ["standard", "high", "none"]}, "claimed_by": {"type": ["string", "null"]}, "delegate": {"type": ["string", "null"]}, "lease_until": {"type": ["string", "null"]}, "reviewer": {"type": ["string", "null"]}, "operator": {"type": "boolean"}, "owner": {"type": ["string", "null"]}, "track": {"type": ["string", "null"]}, "done_criteria": {"type": ["string", "null"]}, "description": {"type": ["string", "null"]}, "host": {"type": ["string", "null"]}, "wait": {"type": ["string", "null"]}, "estimate_h": {"type": ["number", "null"]}, "corrects": {"type": ["string", "null"]}, "fixes": {"type": ["string", "null"]}, "note": {"type": ["string", "null"]}, "unblocks": {"type": "array", "items": {"type": "string"}}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/EvidenceRow"}}, "reviews": {"type": "array", "items": {"$ref": "#/$defs/Review"}}, "fixed_by": {"type": "array", "items": {"type": "string"}}, "run_ids": {"type": "array", "items": {"type": "string"}}, "created_at": {"type": ["string", "null"]}, "done_at": {"type": ["string", "null"]}, "reviewed": {"type": "boolean"}, "merged": {"type": "boolean"}, "waits_on_operator": {"type": "boolean"}}, "required": ["key", "title", "project", "kind", "state", "priority", "review_tier", "epoch", "claimed_by", "delegate", "lease_until", "reviewer", "depends_on", "unblocks", "evidence", "reviews", "reviewed", "merged"]},
    "EvidenceRow": {"type": "object", "properties": {"kind": {"type": "string"}, "verified": {"type": "boolean"}, "at": {"type": ["string", "null"]}, "detail": {"type": ["string", "null"]}, "ref": {"type": "object"}}, "required": ["kind", "verified", "ref"]},
    "Review": {"type": "object", "properties": {"reviewer": {"type": "string"}, "family": {"type": ["string", "null"]}}, "required": ["reviewer", "family"]},
    "Brief": {"type": "object", "properties": {"key": {"type": "string"}, "title": {"type": "string"}, "state": {"enum": ["open", "claimed", "in_review", "done", "cancelled"]}, "kind": {"enum": ["lane", "gate", "goal", "question", "decision", "operator_task"]}, "owner": {"type": ["string", "null"]}, "review_tier": {"enum": ["standard", "high", "none"]}, "evidence_kinds": {"type": "array", "items": {"type": "string"}}, "priority": {"type": "integer"}, "depends_on": {"type": "array", "items": {"$ref": "#/$defs/Dep"}}, "description": {"type": ["string", "null"]}, "done_criteria": {"type": ["string", "null"]}}, "required": ["key", "title", "state", "kind", "review_tier", "evidence_kinds", "priority", "depends_on"]},
    "Blocked": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
    "Waves": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
    "CriticalPath": {"type": "object", "properties": {"keys": {"type": "array", "items": {"type": "string"}}, "hours": {"type": "number"}}, "required": ["keys", "hours"]},
    "Percent": {"type": "number"},
    "Problem": {"type": "object", "properties": {"code": {"type": "string"}, "key": {"type": "string"}, "msg": {"type": "string"}}, "required": ["code", "key", "msg"]},
    "Alerts": {"type": "object", "properties": {"lease_expiring": {"type": "array", "items": {"type": "object", "properties": {"key": {"type": "string"}, "claimed_by": {"type": ["string", "null"]}, "lease_until": {"type": "string"}}, "required": ["key", "lease_until"]}}, "review_overdue": {"type": "array", "items": {"type": "string"}}, "findings": {"type": "array", "items": {"type": "object", "properties": {"ts": {"type": "string"}, "key": {"type": ["string", "null"]}, "code": {"type": "string"}, "msg": {"type": "string"}}}}, "refusals": {"type": "array", "items": {"type": "object", "properties": {"key": {"type": "string"}, "count": {"type": "integer"}}, "required": ["key", "count"]}}, "stalled": {"type": "boolean"}, "warnings": {"type": "array", "items": {"$ref": "#/$defs/Problem"}}}, "required": ["lease_expiring", "review_overdue", "findings", "refusals", "stalled", "warnings"]},
    "Digest": {"type": "object", "properties": {"projects": {"type": "object", "additionalProperties": {"type": "object", "properties": {"open": {"type": "integer"}, "claimed": {"type": "integer"}, "in_review": {"type": "integer"}, "done": {"type": "integer"}, "cancelled": {"type": "integer"}, "stalled": {"type": "boolean"}}, "required": ["open", "claimed", "in_review", "done", "cancelled", "stalled"]}}, "done": {"type": "array", "items": {"type": "object", "properties": {"key": {"type": "string"}, "title": {"type": "string"}, "evidence_kinds": {"type": "array", "items": {"type": "string"}}}, "required": ["key"]}}, "waivers": {"type": "array", "items": {"type": "object", "properties": {"key": {"type": "string"}, "decision_id": {"type": "string"}}, "required": ["key", "decision_id"]}}}, "required": ["projects", "done", "waivers"]},
    "SnapshotItem": {"type": "object", "properties": {"key": {"type": "string"}, "project": {"type": "string"}, "id": {"type": "string"}, "title": {"type": "string"}, "kind": {"enum": ["lane", "gate", "goal", "question", "decision", "operator_task"]}, "state": {"enum": ["open", "claimed", "in_review", "done", "cancelled"]}, "epoch": {"type": "integer"}, "round": {"type": "integer"}, "priority": {"type": "integer"}, "depends_on": {"type": "array", "items": {"type": "string"}}, "evidence_kinds": {"type": "array", "items": {"type": "string"}}, "review_tier": {"enum": ["standard", "high", "none"]}, "claimed_by": {"type": ["string", "null"]}, "delegate": {"type": ["string", "null"]}, "lease_until": {"type": ["string", "null"]}, "reviewer": {"type": ["string", "null"]}, "operator": {"type": "boolean"}, "owner": {"type": ["string", "null"]}, "track": {"type": ["string", "null"]}, "done_criteria": {"type": ["string", "null"]}, "description": {"type": ["string", "null"]}, "host": {"type": ["string", "null"]}, "wait": {"type": ["string", "null"]}, "estimate_h": {"type": ["number", "null"]}, "corrects": {"type": ["string", "null"]}, "fixes": {"type": ["string", "null"]}, "note": {"type": ["string", "null"]}, "reviews": {"type": "array", "items": {"$ref": "#/$defs/Review"}}, "created_at": {"type": ["string", "null"]}, "done_at": {"type": ["string", "null"]}, "reviewed": {"type": "boolean"}, "merged": {"type": "boolean"}, "evidence": {"type": "array", "items": {"type": "object", "properties": {"kind": {"type": "string"}, "verified": {"type": "boolean"}}, "required": ["kind", "verified"]}}, "answer": {"type": ["object", "null"]}}, "required": ["key", "project", "id", "title", "kind", "state", "epoch", "priority", "depends_on", "evidence_kinds", "review_tier", "claimed_by", "lease_until", "operator", "reviews", "reviewed", "merged", "evidence", "answer"]},
    "Snapshot": {"type": "object", "properties": {"generated": {"type": "string"}, "head": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "head_seq": {"type": "integer", "minimum": 0}, "items": {"type": "array", "items": {"$ref": "#/$defs/SnapshotItem"}}, "aliases": {"type": "object", "additionalProperties": {"type": "string"}}, "activity": {"type": "array", "items": {"type": "object", "properties": {"ts": {"type": "string"}, "key": {"type": ["string", "null"]}, "type": {"type": "string"}, "actor": {"type": ["string", "null"]}}, "required": ["ts", "type"]}}, "decision_text": {"type": "object", "additionalProperties": {"type": "string"}}, "progress": {"type": "object"}}, "required": ["generated", "head", "head_seq", "items", "aliases", "activity", "decision_text", "progress"]},
    "Alias": {"type": "object", "properties": {"old": {"type": "string"}, "new": {"type": "string"}, "ts": {"type": ["string", "null"]}, "actor": {"type": ["string", "null"]}, "reason": {"type": ["string", "null"]}}, "required": ["old", "new"]},
    "Aliases": {"type": "array", "items": {"$ref": "#/$defs/Alias"}},
    "NeedsYou": {"type": "array", "items": {"type": "object", "properties": {"key": {"type": "string"}, "project": {"type": "string"}, "title": {"type": "string"}, "kind": {"type": "string"}, "state": {"type": "string"}, "wait": {"type": ["string", "null"]}, "priority": {"type": "integer"}, "unblocks": {"type": "integer"}}, "required": ["key", "project", "kind", "state", "unblocks"]}},
    "Answers": {"type": "array", "items": {"type": "object", "properties": {"key": {"type": "string"}, "project": {"type": "string"}, "kind": {"type": "string"}, "answer": {"type": ["string", "null"]}, "decision_id": {"type": ["string", "null"]}, "done_at": {"type": ["string", "null"]}}, "required": ["key", "kind"]}},
    "Progress": {"type": "object", "properties": {"projects": {"type": "array", "items": {"type": "object", "properties": {"project": {"type": "string"}, "total": {"type": "integer"}, "done": {"type": "integer"}}, "required": ["project", "total", "done"]}}, "total": {"type": "object", "properties": {"total": {"type": "integer"}, "done": {"type": "integer"}}, "required": ["total", "done"]}}, "required": ["projects", "total"]},
    "Changelog": {"type": "object", "properties": {"since": {"type": "string"}, "head_seq": {"type": "integer"}, "entries": {"type": "array", "items": {"type": "object", "properties": {"seq": {"type": "integer"}, "ts": {"type": "string"}, "type": {"enum": ["created", "closed", "answered", "cancelled", "restart"]}, "key": {"type": ["string", "null"]}, "by": {"type": ["string", "null"]}}, "required": ["seq", "ts", "type"]}}}, "required": ["since", "head_seq", "entries"]},
    "AuditMeta": {"type": "object", "properties": {"now": {"type": "string"}, "stale_days": {"type": "integer"}, "projects": {"type": "array", "items": {"type": "object", "properties": {"project": {"type": "string"}}, "required": ["project"]}}, "totals": {"type": "object"}}, "required": ["now", "stale_days", "projects", "totals"]},
    "Created": {"type": "object", "properties": {"created": {"type": "array", "items": {"type": "string"}}, "warnings": {"type": "array", "items": {"type": "string"}}}, "required": ["created"]},
    "KeyOnly": {"type": "object", "properties": {"key": {"type": "string"}}, "required": ["key"]},
    "Claim": {"type": "object", "properties": {"key": {"type": "string"}, "epoch": {"type": "integer"}, "lease_until": {"type": "string"}}, "required": ["key", "epoch", "lease_until"]},
    "Delegate": {"type": "object", "properties": {"key": {"type": "string"}, "delegate": {"type": "string"}}, "required": ["key", "delegate"]},
    "Priority": {"type": "object", "properties": {"key": {"type": "string"}, "priority": {"type": "integer"}}, "required": ["key", "priority"]},
    "Evidence": {"type": "object", "properties": {"key": {"type": "string"}, "kind": {"type": "string"}, "verified": {"type": "boolean"}, "detail": {"type": ["string", "null"]}, "ref": {"type": "object"}}, "required": ["key", "kind", "verified", "ref"]},
    "Submit": {"type": "object", "properties": {"key": {"type": "string"}, "epoch": {"type": "integer"}, "round": {"type": "integer"}, "state": {"const": "in_review"}}, "required": ["key", "epoch", "round", "state"]},
    "Verdict": {"type": "object", "properties": {"key": {"type": "string"}, "state": {"enum": ["done", "in_review", "claimed", "open"]}, "reviews_passed": {"type": "integer"}}, "required": ["key", "state", "reviews_passed"]},
    "Cancel": {"type": "object", "properties": {"key": {"type": "string"}, "state": {"const": "cancelled"}}, "required": ["key", "state"]},
    "Reap": {"type": "object", "properties": {"expired": {"type": "array", "items": {"type": "string"}}, "overdue": {"type": "array", "items": {"type": "string"}}}, "required": ["expired", "overdue"]},
    "Waive": {"type": "object", "properties": {"key": {"type": "string"}, "state": {"type": "string"}, "review_waiver": {"type": "string"}}, "required": ["key", "state", "review_waiver"]},
    "Close": {"type": "object", "properties": {"key": {"type": "string"}, "state": {"const": "done"}, "decision_ids": {"type": "array", "items": {"type": "string"}}, "sha256": {"type": "string"}}, "required": ["key", "state", "decision_ids", "sha256"]},
    "Legacy": {"type": "object", "properties": {"key": {"type": "string"}, "state": {"enum": ["claimed", "in_review"]}, "claimed_by": {"type": ["string", "null"]}}, "required": ["key", "state"]},
    "ApplyOps": {"type": "object", "properties": {"applied": {"type": "integer"}, "results": {"type": "array", "items": {"type": "object"}}}, "required": ["applied", "results"]},
    "Migrate": {"type": "object", "properties": {"migrated": {"type": "array", "items": {"type": "string"}}, "skipped": {"type": "array", "items": {"type": "object", "properties": {"key": {"type": "string"}, "reason": {"type": "string"}}, "required": ["key", "reason"]}}}, "required": ["migrated", "skipped"]},
    "Rehome": {"type": "object", "properties": {"old": {"type": "string"}, "new": {"type": "string"}, "host": {"type": ["string", "null"]}, "repointed": {"type": "array", "items": {"type": "string"}}}, "required": ["old", "new", "repointed"]},
    "RecordRun": {"type": "object", "properties": {"key": {"type": "string"}, "run_id": {"type": "string"}, "phase": {"enum": ["started", "finished"]}, "duplicate": {"type": "boolean"}, "run_ids": {"type": "array", "items": {"type": "string"}}}, "required": ["key", "run_id", "phase"]},
    "Answer": {"type": "object", "properties": {"key": {"type": "string"}, "state": {"const": "done"}, "decision_id": {"type": "string"}}, "required": ["key", "state", "decision_id"]},
    "MintToken": {"type": "object", "properties": {"key": {"type": "string"}, "role": {"enum": ["writer", "reviewer"]}, "run_id": {"type": "string"}, "epoch": {"type": "integer"}, "expires_at": {"type": "string"}, "token": {"type": "string"}}, "required": ["key", "role", "run_id", "epoch", "expires_at", "token"]},
    "Replay": {"type": "object", "properties": {"results": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": ["string", "null"]}, "result": {"type": "string"}}, "required": ["id", "result"]}}}, "required": ["results"]},
    "Withdraw": {"type": "object", "properties": {"key": {"type": "string"}, "state": {"const": "claimed"}, "epoch": {"type": "integer"}, "lease_until": {"type": "string"}}, "required": ["key", "state", "epoch", "lease_until"]},
    "Reopen": {"type": "object", "properties": {"key": {"type": "string"}, "state": {"const": "claimed"}, "epoch": {"type": "integer"}, "claimed_by": {"type": ["string", "null"]}, "lease_until": {"type": "string"}}, "required": ["key", "state", "epoch", "claimed_by", "lease_until"]},
    "SetKind": {"type": "object", "properties": {"key": {"type": "string"}, "kind": {"enum": ["question", "operator_task"]}, "was": {"const": "lane"}}, "required": ["key", "kind", "was"]},
