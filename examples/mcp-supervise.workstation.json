{
  "servers": [
    {
      "name": "plangraph-keeper",
      "port": 8100,
      "cmd": ["python", "-m", "plangraph.keeper"],
      "env": {},
      "scope": "host"
    },
    {
      "name": "serena-plangraph",
      "port": 8102,
      "cmd": ["uvx", "--from", "serena-agent==1.7.0", "serena", "start-mcp-server", "--context", "claude-code", "--project", "C:/path/to/plangraph"],
      "env": {},
      "scope": "project",
      "project_dir": "C:/path/to/plangraph"
    },
    {
      "name": "serena-autoos",
      "port": 8103,
      "cmd": ["uvx", "--from", "serena-agent==1.7.0", "serena", "start-mcp-server", "--context", "claude-code", "--project", "C:/path/to/autoos"],
      "env": {},
      "scope": "project",
      "project_dir": "C:/path/to/autoos"
    }
  ],
  "log_file": "%USERPROFILE%/.plangraph/mcp-supervise.log",
  "state_dir": "%USERPROFILE%/.plangraph/mcp-supervise.state"
}
