{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "V2 config subset from https://opencode.ai/v2/docs/config and /agents; permissions and agents also used in repository opencode.jsonc. Unrelated config is preserved.",
  "type": "object",
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["action", "resource", "effect"],
      "additionalProperties": false,
      "properties": {
        "action": {"type": "string"},
        "resource": {"type": "string"},
        "effect": {"enum": ["allow", "deny", "ask"]}
      }
    }
  },
  "properties": {
    "policies": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "#/$defs/rule"},
          {"properties": {"action": {"enum": ["provider.use", "tool.use", "mcp.use", "skill.use", "plugin.use"]}, "effect": {"enum": ["allow", "deny"]}}}
        ]
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {"enum": ["primary", "subagent", "all"]},
          "steps": {"type": "integer", "minimum": 1},
          "system": {"type": "string"},
          "permissions": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
        }
      }
    }
  }
}
