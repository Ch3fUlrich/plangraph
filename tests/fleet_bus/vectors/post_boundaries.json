        "text": "hello"
      },
      "normalized_ts": 1700000000
    },
    "expect": {
      "id": "1700000000000-000001",
      "ts": 1700000000,
      "msg_id": "message-1",
      "dup": false
    }
  },
  {
    "name": "normalized-string-ts-signature",
    "fn": "validate_post",
    "inputs": {
      "envelope": {
        "from": "sender",
        "to": "receiver",
        "ts": "01700000000",
        "nonce": "nonce-1",
        "msg_id": "message-1",
        "text": "hello"
      },
      "normalized_ts": 1700000000
    },
    "expect": {
      "id": "1700000000000-000001",
      "ts": 1700000000,
      "msg_id": "message-1",
      "dup": false
