    "fn": "validate_post",
    "inputs": {
      "duplicate": true
    },
    "expect": {
      "id": "1700000000000-000001",
      "ts": 1700000000,
      "msg_id": "message-1",
      "dup": true
    }
  },
  {
    "name": "exact-4096-bytes",
