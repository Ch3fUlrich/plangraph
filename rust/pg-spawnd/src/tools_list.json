[
 {
  "description": "Run bounded writer commit probes",
  "inputSchema": {
   "properties": {
    "all_writers": {
     "type": "boolean"
    },
    "json": {
     "type": "boolean"
    },
    "leg": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "timeout": {
     "type": "number"
    }
   },
   "type": "object"
  },
  "name": "plangraph_agent_probe"
 },
 {
  "description": "Spawn an agent task via OmniRoute ACP gateway or dry-run",
  "inputSchema": {
   "properties": {
    "bench_db": {
     "type": "string"
    },
    "card": {
     "properties": {
      "diff_ref": {
       "description": "review: {repo, base, head}; inlined for inline-only seats",
       "type": "object"
      },
      "estimate_tokens": {
       "description": "required: expected tokens of the run",
       "minimum": 1,
       "type": "integer"
      },
      "first_edit_min": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "max_min": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "stall_min": {
       "exclusiveMinimum": 0,
       "type": "number"
      }
     },
     "required": [
      "estimate_tokens"
     ],
     "type": "object"
    },
    "dry_run": {
     "default": false,
     "description": "Plan without starting subprocess",
     "type": "boolean"
    },
    "model_or_combo": {
     "description": "Exceptional audited override only; requires override_reason",
     "type": "string"
    },
    "no_fallthrough": {
     "type": "boolean"
    },
    "override_reason": {
     "type": "string"
    },
    "prompt": {
     "description": "The task instructions for the agent",
     "type": "string"
    },
    "require_bench": {
     "type": "boolean"
    },
    "review_of": {
     "type": "string"
    },
    "review_scope": {
     "enum": [
      "per-fixer",
      "batch"
     ],
     "type": "string"
    },
    "risk": {
     "default": "normal",
     "enum": [
      "low",
      "normal",
      "high",
      "critical"
     ],
     "type": "string"
    },
    "role": {
     "default": "implement",
     "enum": [
      "implement",
      "review",
      "research"
     ],
     "type": "string"
    },
    "seats": {
     "description": "role review: spawn every seat route picks (per writer part); inline-only legs get card.diff_ref inlined",
     "type": "boolean"
    },
    "wait_seconds": {
     "default": 0.0,
     "description": "Seconds to wait synchronously before returning",
     "type": "number"
    },
    "writer_families": {
     "items": {
      "type": "string"
     },
     "type": "array"
    }
   },
   "required": [
    "prompt",
    "card"
   ],
   "type": "object"
  },
  "name": "plangraph_agent_spawn"
 },
 {
  "description": "Check the status of spawned agent jobs",
  "inputSchema": {
   "properties": {
    "job_id": {
     "description": "Specific job ID to query (omit for all jobs)",
     "type": "string"
    },
    "run_id": {
     "type": "string"
    }
   },
   "type": "object"
  },
  "name": "plangraph_agent_status"
 },
 {
  "description": "Send steering instructions or context to an active job",
  "inputSchema": {
   "properties": {
    "job_id": {
     "description": "Target job ID",
     "type": "string"
    },
    "message": {
     "description": "Steering message or instructions",
     "type": "string"
    }
   },
   "required": [
    "job_id",
    "message"
   ],
   "type": "object"
  },
  "name": "plangraph_agent_steer"
 },
 {
  "description": "Cancel an active running job",
  "inputSchema": {
   "properties": {
    "job_id": {
     "description": "Target job ID to cancel",
     "type": "string"
    },
    "run_id": {
     "type": "string"
    }
   },
   "type": "object"
  },
  "name": "plangraph_agent_cancel"
 },
 {
  "description": "Query available models in catalog with intelligence and combo filters",
  "inputSchema": {
   "properties": {
    "combo": {
     "description": "Filter by combo name (e.g. 'l2-worker')",
     "type": "string"
    },
    "family": {
     "description": "Filter by model family (e.g. 'mimo', 'gpt', 'claude')",
     "type": "string"
    },
    "min_intelligence": {
     "description": "Minimum AA Intelligence score",
     "type": "number"
    }
   },
   "type": "object"
  },
  "name": "plangraph_agent_query_catalog"
 },
 {
  "description": "Health check for Plangraph Agent Spawner and OmniRoute gateway connectivity",
  "inputSchema": {
   "properties": {},
   "type": "object"
  },
  "name": "plangraph_agent_health"
 },
 {
  "description": "Launch a background Claude Code session; name is a role (session <role>-NNNN) in role-counter mode, a free name in free mode",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "cwd": {
     "type": "string"
    },
    "dry_run": {
     "type": "boolean"
    },
    "effort": {
     "type": "string"
    },
    "handoff": {
     "type": "string"
    },
    "mcp_config": {
     "type": "string"
    },
    "model": {
     "type": "string"
    },
    "name": {
     "description": "the role; the session gets <role>-NNNN",
     "type": "string"
    },
    "parent": {
     "type": "string"
    },
    "permission_mode": {
     "type": "string"
    },
    "prompt": {
     "type": "string"
    },
    "prompt_file": {
     "type": "string"
    }
   },
   "required": [
    "name",
    "cwd",
    "model",
    "effort",
    "mcp_config",
    "permission_mode"
   ],
   "type": "object"
  },
  "name": "plangraph_session_launch"
 },
 {
  "description": "Stop a Claude Code session by name or id",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string"
    },
    "name": {
     "type": "string"
    }
   },
   "type": "object"
  },
  "name": "plangraph_session_stop"
 },
 {
  "description": "Stop a session and start a NEW one from its handoff; the result name is the new <role>-NNNN; refused if a later session of the role is live",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "handoff": {
     "type": "string"
    },
    "name": {
     "type": "string"
    }
   },
   "required": [
    "name"
   ],
   "type": "object"
  },
  "name": "plangraph_session_relaunch"
 },
 {
  "description": "Mark a session ready with handoff and card",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "card": {
     "type": "string"
    },
    "handoff": {
     "type": "string"
    },
    "name": {
     "type": "string"
    }
   },
   "required": [
    "name",
    "handoff"
   ],
   "type": "object"
  },
  "name": "plangraph_session_mark_ready"
 },
 {
  "description": "List sessions with context usage",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {},
   "type": "object"
  },
  "name": "plangraph_session_list"
 },
