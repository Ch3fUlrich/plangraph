[Unit]
Description=Scheduled liveness probe for every routed review leg

[Service]
Type=oneshot
WorkingDirectory=%h/code/plangraph
Environment=PYTHONPATH=%h/code/plangraph/src
EnvironmentFile=-%h/.config/plangraph/watchdog.env
NoNewPrivileges=yes
ExecStartPre=-%h/.local/bin/pg-spawnd check-manage-key --state %S/plangraph --json
# 10 review legs probed sequentially at 120s each plus ~30s overhead = 1230s, inside the 22min (1320s) start timeout.
ExecStart=/usr/bin/python3 -m plangraph.spawner.cli --state %S/plangraph probe --all-reviewers --timeout 120 --json
TimeoutStartSec=22min
