# plangraph-render.service environment — copy to ~/.config/plangraph/render.env and edit.
# systemd reads this file with EnvironmentFile=, so no `export` and no shell quoting; values are literal.
# This file must not contain any secret. The GitHub token lives only in the file named by
# PLANGRAPH_GH_TOKEN_FILE and is never printed by the units.

# Live tree: a plain git checkout that plangraph.live_follow fast-forwards to the gated head.
# Placeholder — set the real path on the render host (or override it from a drop-in).
PLANGRAPH_LIVE_TREE=/path/to/live/tree

# Where the rendered page is published; plan-cdn.html is written in place (see the service comments).
PLANGRAPH_OUT=/path/to/plan/out

# Upstream repo as owner/name, used by live_follow to query checks. Placeholder.
PLANGRAPH_REPO=owner/name

# File holding the read-only token as KEY=VALUE (one line: GH_TOKEN=...). Keep it mode 0600
# (live_follow does not check permissions).
# Read-only scope: live_follow only reads refs and check runs. Placeholder.
PLANGRAPH_GH_TOKEN_FILE=/path/to/gh-token.env

# State file recording the last head that passed the gate. It MUST live outside PLANGRAPH_OUT:
# that directory is the web-served render output, and gate state does not belong in it.
# (If unset, live_follow falls back to a file under PLANGRAPH_OUT — override it here instead.)
PLANGRAPH_STATE=/path/to/state/live-follow.json

# Optional: workflow FILE the gate pins to; a run counts only when it comes from this file, on this
# head sha, from this repository. Defaults to ".github/workflows/tests.yml". A same-NAMED workflow
# in another file (or a fork's copy) can no longer decide the result, so set this path when the
# tests workflow does not live at the default location.
#PLANGRAPH_CI_WORKFLOW_PATH=.github/workflows/tests.yml

# Optional: command run by `check` when the page stamp is stale past the grace window; gets the alert line as its last argument (argv).
#PLANGRAPH_ALERT_CMD=/path/to/alert-handler

# Optional: how long the page may lag the followed head before ALERT_CMD fires. Default 1800 (30 min).
#PLANGRAPH_ALERT_GRACE_S=1800
