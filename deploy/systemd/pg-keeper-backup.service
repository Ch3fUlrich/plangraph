[Unit]
Description=Dump the keeper schema (pg_dump 17 in docker), keep the newest 14, test the restore

[Service]
Type=oneshot
# See keeper-backup.env.example for the keys in this mode-0600 file.
EnvironmentFile=%h/.config/plangraph/keeper-backup.env
UMask=0077
ExecStart=%h/.local/bin/pg-keeper-backup dump --verify --dir %h/.local/share/plangraph/backups
