[Unit]
Description=Daily feature live probes (D-5050)
OnFailure=pg-live-probe-alert.service

[Service]
Type=oneshot
User=pg-live-probe
StateDirectory=pg-live-probe
ExecStart=/usr/local/bin/pg-live-probe run /etc/plangraph/live-probes.json /var/lib/pg-live-probe/results.jsonl
TimeoutStartSec=1h
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
LimitFSIZE=16M
