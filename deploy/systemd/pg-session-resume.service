[Unit]
Description=Stop finished agent sessions, resume them on findings files, reap idle ones

[Service]
Type=oneshot
ExecStart=%h/.local/bin/pg-session-resume tick
TimeoutStartSec=55s
# A resumed Codex/OpenCode writer is started by the tick and runs for the whole fix round:
# the oneshot's cgroup cleanup must not kill it when the tick exits.
KillMode=process
UMask=0077
NoNewPrivileges=true
