[Unit]
Description=Push the quota snapshot to worker %i

[Service]
Type=oneshot
WorkingDirectory=%h/code/plangraph
# The worker's feeder policy, relative to its home: the file its feeder reads. A worker whose
# feeder runs with `--policy PATH` sets FEEDER_POLICY=PATH in its per-worker file below, which
# overrides this default.
Environment=FEEDER_POLICY=code/plangraph/deploy/feeder/policy.toml
# The same per-worker file the SSH link unit reads (HOST_LINK_SSH), and the gateway
# database setting of the quota alarms (QUOTA_SNAPSHOT_DB).
EnvironmentFile=%h/.config/plangraph/host-links/%i.env
EnvironmentFile=-%h/.config/plangraph/quota-alarms.env
ExecStart=%h/.local/bin/plangraph quota --push ${HOST_LINK_SSH} --worker-policy ${FEEDER_POLICY}
TimeoutStartSec=60s
UMask=0077
NoNewPrivileges=true
