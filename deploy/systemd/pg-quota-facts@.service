[Unit]
Description=Push the quota snapshot to worker %i

[Service]
Type=oneshot
WorkingDirectory=%h/code/plangraph
# The worker's feeder policy as its feeder takes it (`--policy PATH`): relative to the worker's
# checkout (the feeder's working directory) or absolute. The same FEEDER_POLICY is set for the
# worker's feeder (pg-feeder.service); a worker whose feeder uses another file sets it in its own
# env file and in the per-worker file below, which override this default.
Environment=FEEDER_POLICY=deploy/feeder/policy.toml
# The same per-worker file the SSH link unit reads (HOST_LINK_SSH), and the gateway
# database setting of the quota alarms (QUOTA_SNAPSHOT_DB).
EnvironmentFile=%h/.config/plangraph/host-links/%i.env
EnvironmentFile=-%h/.config/plangraph/quota-alarms.env
ExecStart=%h/.local/bin/plangraph quota --push ${HOST_LINK_SSH} --worker-policy ${FEEDER_POLICY}
TimeoutStartSec=60s
UMask=0077
NoNewPrivileges=true
