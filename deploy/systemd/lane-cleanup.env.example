# EnvironmentFile for pg-lane-cleanup.service (read after disk-hygiene.env).
PG_GH_REPO=OWNER/NAME
PG_LANE_STATE=/home/USER/.local/state/plangraph/lane-cleanup
# The git remote that authenticates as the land App; mark it once with
#   git config remote.<name>.plangraph-lane-delete app
PG_LANE_DELETE_REMOTE=origin
