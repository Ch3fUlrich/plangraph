[Unit]
Description=Renew the orchestrator's held keeper claims from the live writer roster
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/code/plangraph
EnvironmentFile=-%h/.config/plangraph/plangraph.env
# PG_URL and PG_TOKEN_FILE name the orchestrator principal's token (role l1). Every renewal,
# refusal and unrenewed claim goes to the journal with its item key; a refusal fails the unit.
ExecStart=%h/.local/bin/plangraph claim-heartbeat
TimeoutStartSec=300
UMask=0077
