[Unit]
Description=plangraph static page: follow main, render, stamp check

[Service]
Type=oneshot
# Render host: a fast-forwarded live checkout at $PLANGRAPH_LIVE_TREE; paths and tokens live in render.env,
# documented by deploy/systemd/render.env.example. Adjust the file location if config lives elsewhere.
EnvironmentFile=%h/.config/plangraph/render.env
Environment=PG_URL=http://127.0.0.1:8787
# Leading '-' on both hooks: a failing follow or stamp check must never block the render.
ExecStartPre=-/bin/bash -c 'PYTHONPATH="$PLANGRAPH_LIVE_TREE/src" exec python3 -m plangraph.live_follow follow'
# The page stamp is the short sha `live_follow export` prints (the exported copy has no .git of its own).
# The render runs only from a revision the gate recorded as CI-green: `live_follow export` fails when the checkout
# is not that head (first start, hand-moved checkout, refused fast-forward) and the previous page stays up. On success
# it copies exactly that commit to a private tree and prints "<tree> <short sha>"; the render imports the copy, so local
# edits or untracked files in the live checkout never reach the published page.
# Render to a temp file first, so a failed or empty render leaves the old page untouched (the `</html>` guard);
# `cat "$T" > file` publishes it: copying into the destination keeps its inode, because the web server
# bind-mounts that single file (a `mv` would swap the inode and the container would keep serving the old one).
ExecStart=/bin/bash -o pipefail -c 'read -r R S < <(PYTHONPATH="$PLANGRAPH_LIVE_TREE/src" python3 -m plangraph.live_follow export) && [ -n "$R" ] && export PYTHONPATH="$R/src" PLANGRAPH_BUILD_SHA="$S" && T=$(mktemp "$PLANGRAPH_OUT"/.plan-render.XXXXXX) && python3 -m plangraph.keeper.cli render --cdn --out "$T" >/dev/null && [ -s "$T" ] && grep -q "</html>" "$T" && cat "$T" > "$PLANGRAPH_OUT"/plan-cdn.html; rc=$?; rm -f "$T"; exit $rc'
# The stamp check is ExecStopPost, not ExecStartPost: for a Type=oneshot unit ExecStartPost only runs when
# ExecStart succeeded, but the staleness alert exists exactly for the failed-render case; ExecStopPost runs
# after ExecStart whether or not it succeeded. Keep the leading '-': a failing check must not taint the unit.
ExecStopPost=-/bin/bash -c 'PYTHONPATH="$PLANGRAPH_LIVE_TREE/src" exec python3 -m plangraph.live_follow check'
