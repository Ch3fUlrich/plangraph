[Unit]
Description=plangraph static page: follow main, render, stamp check

[Service]
Type=oneshot
# Render host: a fast-forwarded live checkout at $PLANGRAPH_LIVE_TREE; paths and tokens live in render.env,
# documented by deploy/systemd/render.env.example. Adjust the file location if config lives elsewhere.
EnvironmentFile=%h/.config/plangraph/render.env
Environment=PG_URL=http://127.0.0.1:8787
# A follow failure can leave the last verified checkout usable.
ExecStartPre=-/bin/bash -c 'PYTHONPATH=\"$PLANGRAPH_LIVE_TREE/src\" exec python3 -m plangraph.live_follow follow'
# Render an immutable copy of the verified revision. Preserve the published inode for the single-file bind mount.
ExecStart=/bin/bash -o pipefail -c 'S=$(PYTHONPATH=\"$PLANGRAPH_LIVE_TREE/src\" python3 -m plangraph.live_follow render-ready) || exit $?; D=$(mktemp -d) || exit $?; T=$(mktemp \"$PLANGRAPH_OUT\"/.plan-render.XXXXXX) || { rmdir \"$D\"; exit 1; }; git --no-replace-objects -C \"$PLANGRAPH_LIVE_TREE\" archive \"$S\" -- src vendor | tar -x -C \"$D\" && PLANGRAPH_BUILD_SHA=\"$S\" PYTHONPATH=\"$D/src\" PLANGRAPH_VENDOR=\"$D/vendor\" python3 -m plangraph.keeper.cli render --cdn --out \"$T\" >/dev/null && [ -s \"$T\" ] && grep -q \"</html>\" \"$T\" && cat \"$T\" > \"$PLANGRAPH_OUT\"/plan-cdn.html; rc=$?; rm -rf \"$D\"; rm -f \"$T\"; exit $rc'
# The stamp check is ExecStopPost, not ExecStartPost: for a Type=oneshot unit ExecStartPost only runs when
# ExecStart succeeded, but the staleness alert exists exactly for the failed-render case; ExecStopPost runs
# after ExecStart whether or not it succeeded. Keep the leading '-': a failing check must not taint the unit.
ExecStopPost=-/bin/bash -c 'PYTHONPATH="$PLANGRAPH_LIVE_TREE/src" exec python3 -m plangraph.live_follow check'
