[Unit]
Description=plangraph shadow state collector for %i
After=network-online.target

[Service]
Type=simple
UMask=0077
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/plangraph/plangraph.env
EnvironmentFile=%h/.config/plangraph/state-shadow/%i.env
ExecStart=%h/.local/bin/plangraph state wait --role %i
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
