[Unit]
Description=Deterministic flow watchdog (D-5050)

[Service]
Type=oneshot
Environment=PLANGRAPH_WATCHDOG_PROC_ROOT=/proc
EnvironmentFile=%h/.config/plangraph/flow-watchdog.env
ExecStart=%h/.local/bin/flow-watchdog %h/.local/state/plangraph/flow-snapshot.json %h/.local/state/plangraph/flow-watchdog --deleted-cwd-proc /proc
UMask=0077
NoNewPrivileges=true
