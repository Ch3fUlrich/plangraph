#!/usr/bin/env python3
"""Pre-push gate: public scrub (D-1751) + 800-line file size (AO-400LOC, D-3198).

Runs scrub rules over committed blobs in the pushed range, including preflight;
new branches scrub from origin/main and select affected test files from their nearest remote base.
Missing preflight refuses main pushes; topic and tag pushes retain the other gates.
A push to refs/heads/lane/* runs the public scrub, the commit
gate (with its open-PR query) and the stamp gate only (seconds, no worktree, no test): a lane head needs a green
`plangraph fast-checks` receipt of exactly that head in the same push (no bypass), as a per-lane
receipt ref (refs/notes/plangraph-fast-checks-<lane>, the designated ref of that lane head) that is one
parentless commit holding nothing but well-formed receipts, validated and scrubbed like any pushed content.
A receipt ref without its lane head, or another lane's receipt ref, is refused.
Train pushes run the seconds-fast checks only (preflight --lane: scrub, policy, skill lint,
cargo fmt) and no test; the affected tests run once, in CI. A push to refs/heads/land/train-* is a
train: its first-parent chain must carry the merges listed in the manifest in order, with
attributed resolution or drop commits allowed between merges. PLANGRAPH_TRAIN_MANIFEST
names the file of part heads. The manifest check replaces the open-PR parent check.
PREFLIGHT_SKIP=1 records a local test skip on land/* pushes; all other gates still run.
Phase pushes still run affected preflight with legacy flags. Other refs refuse the flag.
When origin/main is available, identical upstream/base blobs and inherited lines
are excluded; without it the stricter whole-file scan remains in effect.
PLANGRAPH_SCRUB_WORDS overrides ~/.config/plangraph/scrub-words.txt; an explicit
unreadable list refuses every push. Public remotes use the default (chmod 600);
if absent, warn once. remote.<name>.plangraph-private=true skips private matching.
Public patterns always run; PLANGRAPH_SCRUB_RULES adds rules. Any hit refuses (exit 1); output
is file:line and rule id only -- a matched value is never printed, nor the words-file
path. Existing tags are immutable, even when the move would fast-forward.
Install: git config core.hooksPath tools/hooks (see CONTRIBUTING.md).
"""
from __future__ import annotations

import os
from contextlib import contextmanager
import time
import json
import tempfile
import shutil
import re
import subprocess
import sys
from pathlib import Path

PYTHON = sys.executable
TOOLS = Path(__file__).resolve().parent.parent
SPLIT = TOOLS / "split"
FILE_SIZE = TOOLS / "check_file_size.py"
CHANGELOG_DOCS = TOOLS / "check_changelog_docs.py"
sys.path.insert(0, str(TOOLS))
sys.path.insert(0, str(SPLIT))
import scrub_check as sc  # noqa: E402

# Public allow-lists reviewed into the repo; loaded always so pushes of already
# vetted files behave like the CI tree scan.  Never a place for private words.
BASE_RULES = ("manifest.toml", "scrub_ci.toml")

def git(*args):
    return subprocess.run(["git", "--no-replace-objects", *args], capture_output=True, timeout=30)


def is_zero(oid):
    return bool(oid) and set(oid) == {"0"}


def git_out(*args):
    r = git(*args)
    return r.stdout.decode("utf-8", "replace").strip() if r.returncode == 0 else ""


def refresh_origin():
    """Only fresh, pruned branch refs may vouch for previously tested parts."""
    try:
        return git("fetch", "--quiet", "--prune", "origin",
                   "+refs/heads/*:refs/remotes/origin/*").returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def affected_base_commit(remote_sha, local_sha):
    """Exclude merged upstream changes only when doing so preserves the pushed base."""
    base = pushed_base_commit(remote_sha, local_sha)
    if not is_zero(remote_sha) and base == remote_sha:
        main = "refs/remotes/origin/main"
        upstream = git_out("merge-base", main, local_sha)
        if (upstream and upstream != remote_sha and
                git("merge-base", "--is-ancestor", remote_sha, upstream).returncode == 0):
            merges = git_out("rev-list", "--min-parents=2", "--parents",
                             f"{remote_sha}..{local_sha}")
            for merge in merges.splitlines():
                for parent in merge.split()[2:]:
                    if git("merge-base", "--is-ancestor", parent, main).returncode == 0:
                        return upstream
    return base


def pushed_base_commit(remote_sha, local_sha):
    """What the pushed commits add: the remote sha when the push fast-forwards,
    else a merge-base; a new branch uses its nearest remote merge-base, and
    with no usable base at all, everything in the pushed commits is checked."""
    if not is_zero(remote_sha) and git("cat-file", "-e", remote_sha + "^{commit}").returncode == 0:
        if git("merge-base", "--is-ancestor", remote_sha, local_sha).returncode == 0:
            return remote_sha
        mb = git_out("merge-base", remote_sha, local_sha)
        if mb:
            return mb
    else:
        best, distance = "", None
        # A stacked branch inherits its phase history. Choose the closest known
        # remote merge-base so affected tests cover only the branch's changes.
        refs = git_out("for-each-ref", "--format=%(refname)", "refs/remotes/origin").splitlines()
        refs.sort(key=lambda ref: (ref != "refs/remotes/origin/main", ref))
        for ref in refs:
            if ref.endswith("/HEAD"):
                continue
            mb = git_out("merge-base", ref, local_sha)
            count = git_out("rev-list", "--count", f"{mb}..{local_sha}") if mb else ""
            if count.isdigit() and (distance is None or int(count) < distance):
                best, distance = mb, int(count)
        if best:
            return best
    return git_out("hash-object", "-t", "tree", "--stdin")


def base_commit(remote_sha, local_sha):
    """Public scrub must cover inherited stacked history on a new remote branch."""
    if not is_zero(remote_sha):
        return pushed_base_commit(remote_sha, local_sha)
    main = git_out('rev-parse', '--verify', '-q', 'refs/remotes/origin/main^{commit}')
    base = git_out('merge-base', main, local_sha) if main else ''
    return base or git_out('hash-object', '-t', 'tree', '--stdin')


def main_baselines(local_sha):
    """Only locally known upstream history can exempt inherited content."""
    main = git_out("rev-parse", "--verify", "-q", "refs/remotes/origin/main^{commit}")
    if not main:
        return []
    base = git_out("merge-base", main, local_sha)
    return list(dict.fromkeys(oid for oid in (main, base) if oid))


def scan_blob(rel, local_sha, cfg, find_shapes, hits, baselines=()):
    entry = git_out("ls-tree", local_sha, "--", rel)
    baseline_data = []
    for baseline in baselines:
        old_entry = git_out("ls-tree", baseline, "--", rel)
        if entry and entry == old_entry:
            return
        old = git("show", f"{baseline}:{rel}")
        if old.returncode == 0:
            baseline_data.append(old.stdout)
    r = git("show", f"{local_sha}:{rel}")
    # Gitlinks can name unavailable objects; their paths still need scanning.
    data = r.stdout if r.returncode == 0 else b""
    found, _ = sc.scan_content(rel, data, cfg, find_shapes,
                               symlink=entry.startswith("120000 "), baselines=baseline_data)
    hits.extend(found)


def file_size_gate(head):
    """Measure the pushed tree, including its allow-list and baseline."""
    r = subprocess.run([PYTHON, str(FILE_SIZE), "--head", head], capture_output=True, text=True, timeout=60)
    if r.returncode != 0:
        sys.stderr.write(r.stdout + r.stderr)
        print("pre-push: file-size gate failed: push refused (split the file, "
              "see CONTRIBUTING.md)", file=sys.stderr)
        return 1
    return 0


TRAIN_REF_PREFIX = "refs/heads/land/train-"


def is_train_ref(remote_ref):
    return remote_ref.startswith(TRAIN_REF_PREFIX) and len(remote_ref) > len(TRAIN_REF_PREFIX)


LANE_REF_PREFIX = "refs/heads/lane/"
RECEIPT_REF_PREFIX = "refs/notes/plangraph-fast-checks"


def is_receipt_ref(remote_ref):
    """A published receipt ref: `refs/notes/plangraph-fast-checks-<lane>` (one parentless commit per head)."""
    return remote_ref.startswith(RECEIPT_REF_PREFIX + "-") and len(remote_ref) > len(RECEIPT_REF_PREFIX) + 1


def plangraph_fast_checks(*args):
    """Run `plangraph fast-checks ...`; (ok, message). The one reader of receipts is the Rust one."""
    try:
        result = subprocess.run(["plangraph", "fast-checks", *args], capture_output=True, text=True, timeout=60)
    except FileNotFoundError:
        return False, "plangraph binary not found on PATH (required for the receipt gate)"
    except (OSError, subprocess.TimeoutExpired) as exc:
        return False, f"receipt gate failed ({type(exc).__name__})"
    return result.returncode == 0, (result.stderr or result.stdout).strip()


def receipt_ref_gate(commit, remote_ref):
    """A receipt ref may carry only well-formed receipts (each file named by its head)."""
    ok, message = plangraph_fast_checks("--check-notes", commit)
    if not ok:
        print(f"pre-push: {remote_ref} is not a receipt ref ({message}): push refused", file=sys.stderr)
    return 0 if ok else 1


def is_lane_ref(remote_ref):
    """A writer's lane branch: only scrub, commit gate and stamp run for it."""
    return remote_ref.startswith(LANE_REF_PREFIX) and len(remote_ref) > len(LANE_REF_PREFIX)


def stamp_gate(head, lane_ref, receipts):
    """A lane head is pushed with the green receipt of exactly that head in its designated receipt
    ref, in the same push: a local stamp, or a receipt that belongs to another lane, publishes nothing."""
    ok, designated = plangraph_fast_checks("--receipt-ref", lane_ref)
    commit = receipts.get(designated.strip()) if ok else None
    reason = designated if not ok else ""
    if commit:
        ok, reason = plangraph_fast_checks("--stamp-green", head, "--notes-commit", commit)
        if ok:
            return 0
    detail = f" ({reason})" if reason else ""
    print(f"pre-push: no green fast-checks receipt of {head[:12]} in {designated.strip() or 'its receipt ref'} "
          f"in this push{detail}: run `plangraph fast-checks --owned-worktree` on this head and push the head "
          "with its receipt exactly as the brief's PUSH line prints it (atomic): push refused", file=sys.stderr)
    return 1


def lane_or_train_ref(remote_ref):
    """Phase pushes retain affected preflight; lanes and trains use the fast push path."""
    return (remote_ref.startswith("refs/heads/") and remote_ref != "refs/heads/main"
            and not remote_ref.startswith("refs/heads/phase/"))


def train_gate(local_sha, manifest):
    """Delegate the first-parent proof to the same validator as land-train verify."""
    if not manifest:
        return "train manifest missing (set PLANGRAPH_TRAIN_MANIFEST)"
    try:
        result = subprocess.run(
            ["plangraph", "land-train", "check-chain", "--repo", ".",
             "--head", local_sha, "--heads", manifest],
            capture_output=True, text=True, timeout=30,
        )
    except FileNotFoundError:
        return "plangraph binary not found on PATH (required for land-train check-chain)"
    except OSError as exc:
        return f"cannot run plangraph land-train check-chain: {exc}"
    return None if result.returncode == 0 else result.stderr.strip() or "train chain validation failed"


def planned_parts(body, layouts):
    """Read only the PR's part tables, with optional PR numbers and abbreviated heads."""
    columns = pending = None
    fence = None
    for line in body.splitlines():
        marker = re.match(r"^ {0,3}(`{3,}|~{3,})", line)
        if fence:
            if re.fullmatch(rf" {{0,3}}{fence[0]}{{{len(fence)},}}[ \t]*", line):
                fence = None
            continue
        if marker:
            fence = marker[1]
        if marker or not (line.startswith("|") and line.rstrip().endswith("|")):
            columns = pending = None
            continue
        cells = [cell.strip() for cell in re.split(r"(?<!\\)\|", line.rstrip()[1:-1])]
        if pending is not None:
            width, layout = pending
            pending = None
            if len(cells) == width and all(re.fullmatch(r":?-{3,}:?", cell) for cell in cells):
                columns = (width, layout)
                continue
        layout = layouts.get(tuple(cell.casefold() for cell in cells))
        if layout is not None:
            columns = None
            pending = (len(cells), layout)
            continue
        if columns is None:
            continue
        width, (pr_column, head_column) = columns
        if len(cells) != width:
            columns = None
            continue
        head = re.fullmatch(r"(`?)([0-9a-f]{8,40})\1(?:[ \t]+\(.+\))?", cells[head_column], re.I)
        if pr_column is None:
            pr = re.search(r"\(folded #([1-9][0-9]*)\)$", cells[0], re.I)
        else:
            pr = re.fullmatch(r"#([1-9][0-9]*)", cells[pr_column].strip("`"))
        if head and (pr_column is None or pr):
            yield int(pr[1]) if pr else None, head[2].lower()


def batch_state_parts(branch):
    from merge_batch_util import MergeBatchError, load_state

    try:
        state = load_state(branch.removeprefix("batch/"))
    except (MergeBatchError, OSError, UnicodeError):
        return
    if (not isinstance(state, dict) or state.get("branch") != branch
            or state.get("status") not in ("built", "pushed") or not isinstance(state.get("merged"), list)):
        return
    for part in state["merged"]:
        if (isinstance(part, dict) and type(part.get("pr")) is int
                and isinstance(part.get("head"), str) and re.fullmatch(r"[0-9a-f]{40}", part["head"])):
            yield part["pr"], part["head"]


def recorded_parts(branch, own):
    body = (own[0]["body"] or "") if len(own) == 1 else ""
    if branch.startswith("land/train-"):
        yield from planned_parts(body, {
            ("part", "pr", "part head", "plan-item keys", "writers", "part review (family)",
             "ancestor of train head"): (1, 2),
            ("part", "head", "writer (harness)", "review", "keys"): (None, 1),
        })
    elif branch.startswith("batch/"):
        yield from planned_parts(body, {("pr", "plan-item", "head", "merge", "title"): (0, 2)})
        yield from batch_state_parts(branch)


def folded_heads(prs, parts):
    """Resolve the exact recorded commits and keep a SHA if another PR at it is foreign."""
    recorded = set()
    for number, prefix in parts:
        matches = [prefix] if len(prefix) == 40 else git_out("rev-parse", f"--disambiguate={prefix}").splitlines()
        if len(matches) == 1:
            recorded.add((number, matches[0]))
    heads = {pr["headRefOid"] for pr in prs}
    foreign = {pr["headRefOid"] for pr in prs
               if (pr["number"], pr["headRefOid"]) not in recorded
               and (None, pr["headRefOid"]) not in recorded}
    return heads, heads - foreign


def commit_gate(head, remote_ref="", remote_sha="", *, open_prs=True):
    """Check commit trailers and, when enabled, foreign open-PR parents."""
    base = git_out("rev-parse", "--verify", "refs/remotes/origin/main^{commit}")
    if not base:
        print("pre-push: origin/main unavailable: commit gate refused", file=sys.stderr)
        return 1
    command = [PYTHON, str(TOOLS / "ci_commit_gate.py"), "check", "--base", base, "--head", head]
    result = subprocess.run(command, capture_output=True, text=True)
    sys.stderr.write(result.stdout + result.stderr)
    if result.returncode or not open_prs:
        return result.returncode
    try:
        probe = subprocess.run(
            ["gh", "pr", "list", "--state", "open", "--limit", "10000",
             "--json", "number,headRefName,headRefOid,isCrossRepository,body"],
            capture_output=True, text=True, timeout=15)
        if probe.returncode:
            raise OSError("open PR query unavailable")
        prs = json.loads(probe.stdout)
        if not isinstance(prs, list):
            raise ValueError("invalid open PR list")
        for pr in prs:
            sha = pr["headRefOid"]
            if (not re.fullmatch(r"[0-9a-f]{40}", sha) or type(pr["number"]) is not int
                    or not isinstance(pr["headRefName"], str) or type(pr["isCrossRepository"]) is not bool
                    or (pr["body"] is not None and not isinstance(pr["body"], str))):
                raise ValueError("invalid open PR record")
            if git("cat-file", "-e", sha + "^{commit}").returncode:
                if git("fetch", "--quiet", "origin", sha).returncode:
                    raise OSError("open PR head fetch unavailable")
    except (ValueError, KeyError, TypeError):
        print("pre-push: invalid open PR response: push refused", file=sys.stderr)
        return 1
    except (OSError, subprocess.TimeoutExpired):
        print("pre-push: open PR merge check skipped (network/gh unavailable); local trailer gate passed",
              file=sys.stderr)
        return 0
    branch = remote_ref.removeprefix("refs/heads/") if remote_ref.startswith("refs/heads/") else ""
    own = [pr for pr in prs if branch and pr["headRefName"] == branch
           and pr["headRefOid"] == remote_sha.lower() and not pr["isCrossRepository"]]
    heads, folded = folded_heads([pr for pr in prs if pr not in own], recorded_parts(branch, own))
    with tempfile.TemporaryDirectory() as tmp:
        path = Path(tmp) / "open-heads"
        path.write_text("\n".join(sorted(heads)), encoding="utf-8")
        if folded:
            parts = Path(tmp) / "folded-heads"
            parts.write_text("\n".join(sorted(folded)), encoding="utf-8")
            command.extend(["--folded-heads", str(parts)])
        return subprocess.run([*command, "--open-heads", str(path)]).returncode


def changelog_docs_warn(base, head):
    """tools/check_changelog_docs.py --warn-only on base..head (the pushed sha): never refuses (D-653)."""
    if not CHANGELOG_DOCS.is_file():
        return
    r = subprocess.run(
        [PYTHON, str(CHANGELOG_DOCS), "--base", base, "--head", head, "--warn-only"],
        capture_output=True,
        text=True,
        timeout=60,
    )
    if r.stdout:
        sys.stderr.write(r.stdout)
    if r.stderr:
        sys.stderr.write(r.stderr)


def python_interpreter(root):
    """Prefer this checkout's venv, then PREFLIGHT_PYTHON, then PATH python3."""
    root = Path(root)
    for relative in ('.venv/bin/python', '.venv/Scripts/python.exe'):
        candidate = root / relative
        if candidate.is_file():
            return str(candidate.absolute())
    configured = os.environ.get('PREFLIGHT_PYTHON')
    return str(Path(configured).expanduser().absolute()) if configured else shutil.which('python3') or 'python3'


@contextmanager
def preflight_checkout(head):
    """Isolate tests from both other branches and dirty files at the same HEAD."""
    with tempfile.TemporaryDirectory(prefix="plangraph-push-") as tmp:
        checkout = Path(tmp) / "tree"
        result = git("worktree", "add", "--detach", str(checkout), head)
        if result.returncode:
            raise SystemExit("pre-push: cannot create pushed-head worktree: push refused")
        try:
            yield checkout
        finally:
            result = git("worktree", "remove", "--force", str(checkout))
            if result.returncode:
                raise SystemExit("pre-push: cannot remove pushed-head worktree: push refused")


def main():
    started = time.time_ns() // 1_000_000
    try:
        outcome = push_main()
    except subprocess.TimeoutExpired:
        print("pre-push: subprocess timeout: push refused", file=sys.stderr)
        outcome = 1
    repo, batch, head = (os.environ.get(name) for name in
                         ("PG_LANDING_REPO", "PG_LANDING_BATCH", "PG_LANDING_STAGE_HEAD"))
    if repo and batch and head:
        payload = {"action": "stage", "repo": repo, "batch_key": batch, "head": head,
                   "stage": "fast_checks", "attempt": started, "started_at_ms": started,
                   "ended_at_ms": max(started, time.time_ns() // 1_000_000)}
        try:
            receipt = subprocess.run(["plangraph", "landing", "journal"], input=json.dumps(payload),
                                     text=True, stdout=subprocess.DEVNULL, timeout=35)
            if receipt.returncode:
                print("pre-push: landing timing pending keeper delivery", file=sys.stderr)
        except (OSError, subprocess.TimeoutExpired):
            print("pre-push: landing timing pending keeper delivery", file=sys.stderr)
    return outcome


def hook_checkout_status():
    """Judge the gate's checkout, independently of the repository being pushed."""
    env = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}

    def checkout_git(*args):
        result = subprocess.run(["git", "-C", str(TOOLS.parent), *args],
                                env=env, stdin=subprocess.DEVNULL, capture_output=True, timeout=30)
        return result.stdout.decode("utf-8", "replace").strip() if result.returncode == 0 else None

    head = checkout_git("rev-parse", "--short", "HEAD")
    print(f"pre-push: hook checkout head={head or 'unavailable'}", flush=True)
    # An old cached upstream tip cannot establish freshness. Refresh it before
    # judging the hook, even if hourly discovery has missed this checkout.
    tip_time = (checkout_git("show", "-s", "--format=%ct", "refs/remotes/origin/main")
                or checkout_git("show", "-s", "--format=%ct", "HEAD") or "")
    if tip_time.isdigit() and time.time() - int(tip_time) > 86400:
        if checkout_git("fetch", "--quiet", "origin",
                        "refs/heads/main:refs/remotes/origin/main") is None:
            print("pre-push: cannot refresh hook checkout origin/main: push refused",
                  file=sys.stderr)
            return 1
    # First-parent dates describe main's progress, excluding old topic commits
    # introduced by a recent merge. An old HEAD alone does not make a gate stale.
    missing = checkout_git("log", "--first-parent", "--format=%ct",
                           "HEAD..refs/remotes/origin/main") or ""
    if any(stamp.isdigit() and time.time() - int(stamp) > 86400
           for stamp in missing.splitlines()):
        print("pre-push: stale hook checkout: more than a day behind origin/main; "
              "run pg-repo-sync --repo " + str(TOOLS.parent) +
              " (clean main required), then push again", file=sys.stderr)
        return 1
    return 0


def push_main():
    if hook_checkout_status():
        return 1
    global PYTHON
    cargo_bin = Path.home() / '.cargo/bin'
    if cargo_bin.is_dir():
        os.environ['PATH'] = str(cargo_bin) + os.pathsep + os.environ.get('PATH', '')
    refs = [rec.split(maxsplit=3) for rec in sys.stdin.read().splitlines()]
    if not refs:
        return 0
    skip_tests = os.environ.get("PREFLIGHT_SKIP") == "1"
    for rec in refs:
        if (len(rec) != 4 or
                not all(re.fullmatch(r"[0-9a-fA-F]+", rec[i]) for i in (1, 3)) or
                len(rec[1]) != len(rec[3]) or
                git("check-ref-format", rec[2]).returncode != 0):
            print("pre-push: malformed push record: push refused", file=sys.stderr)
            return 1
        _, local_sha, remote_ref, remote_sha = rec
        if is_zero(local_sha):
            print(f"pre-push: refused delete of {remote_ref}", file=sys.stderr)
            return 1
        if is_zero(remote_sha) or is_receipt_ref(remote_ref):
            # A receipt ref has one writer per lane and is replaced, not merged.
            continue
        if git("cat-file", "-e", remote_sha).returncode != 0:
            print(f"pre-push: remote object unavailable for {remote_ref}: push refused",
                  file=sys.stderr)
            return 1
        if local_sha == remote_sha:
            continue
        if remote_ref.startswith("refs/tags/"):
            print(f"pre-push: refused update of existing tag {remote_ref}: tags are immutable",
                  file=sys.stderr)
            return 1
        is_commit = git_out("cat-file", "-t", remote_sha) == "commit"
        if (not is_commit or git(
                "merge-base", "--is-ancestor", remote_sha, local_sha).returncode != 0):
            print(f"pre-push: refused non-fast-forward update of {remote_ref}",
                  file=sys.stderr)
            return 1
    # Ref-safety diagnostics take precedence across the whole push.
    if skip_tests:
        for _, _, remote_ref, _ in refs:
            if not remote_ref.startswith(("refs/heads/land/", "refs/heads/phase/")):
                print(f"pre-push: PREFLIGHT_SKIP=1 is not allowed for {remote_ref}: push refused",
                      file=sys.stderr)
                return 1
    refs = [rec for rec in refs if not is_zero(rec[1])]
    if not refs:
        return 0
    PYTHON = python_interpreter(Path(git_out("rev-parse", "--show-toplevel")))
    print(f"pre-push Python: {PYTHON}", flush=True)
    receipts = {rec[2]: rec[1] for rec in refs if is_receipt_ref(rec[2])}
    # A receipt ref is not a branch (no commit trailers or file sizes): its commit is validated first
    # (one parentless commit of well-formed receipts) and scrubbed below, before any lane head is judged
    # by it. A receipt travels only as the designated ref of a lane head in the same push.
    for _, local_sha, remote_ref, _ in refs:
        if is_receipt_ref(remote_ref) and receipt_ref_gate(local_sha, remote_ref):
            return 1
    designated = set()
    for _, _, remote_ref, _ in refs:
        if is_lane_ref(remote_ref):
            ok, name = plangraph_fast_checks("--receipt-ref", remote_ref)
            designated.add(name.strip() if ok else "")
    for remote_ref in receipts:
        if remote_ref not in designated:
            print(f"pre-push: {remote_ref} is not the receipt ref of a lane head in this push: push refused",
                  file=sys.stderr)
            return 1
    for _, local_sha, remote_ref, remote_sha in refs:
        if is_receipt_ref(remote_ref):
            continue
        train = is_train_ref(remote_ref)
        if train:
            problem = train_gate(local_sha, os.environ.get("PLANGRAPH_TRAIN_MANIFEST"))
            if problem:
                print(f"pre-push: {problem}: push refused", file=sys.stderr)
                return 1
            print(f"pre-push: train path for {remote_ref}: manifest ok, no affected tests", file=sys.stderr)
        # The first train push is backed by the manifest alone. Updates also
        # check the existing PR plan and distinguish its parts from foreign PRs.
        open_prs = not train or not is_zero(remote_sha)
        if commit_gate(local_sha, remote_ref, remote_sha, open_prs=open_prs) or file_size_gate(local_sha):
            return 1
        if is_lane_ref(remote_ref) and stamp_gate(local_sha, remote_ref, receipts):
            return 1
    explicit = "PLANGRAPH_SCRUB_WORDS" in os.environ
    words = os.environ.get("PLANGRAPH_SCRUB_WORDS") if explicit else None
    remote = sys.argv[1] if len(sys.argv) > 1 else "origin"
    private = git_out("config", "--local", "--bool", f"remote.{remote}.plangraph-private") == "true"
    try:
        if explicit:
            path = Path(words)
            if not words or not path.stat().st_mode & 0o444:
                raise PermissionError
            with path.open("rb"):
                pass
        elif not private:
            path = Path.home() / ".config/plangraph/scrub-words.txt"
            try:
                mode = path.stat().st_mode
            except FileNotFoundError:
                print("pre-push: PLANGRAPH_SCRUB_WORDS unset: public patterns only, "
                      "the private-word rule is inactive", file=sys.stderr)
            else:
                if mode & 0o077:
                    print("pre-push: private list requires chmod 600: push refused", file=sys.stderr)
                    return 1
                if not mode & 0o444:
                    raise PermissionError
                words = str(path)
        if private:
            words = None
    except Exception as exc:  # fail closed; never echo the paths
        print(f"pre-push: bad scrub config: {type(exc).__name__}: push refused",
              file=sys.stderr)
        if isinstance(exc, ValueError) and "word list line" in str(exc):
            print(f"pre-push: {exc}", file=sys.stderr)
        return 1
    find_shapes = sc._shape_finder()
    hits = []
    # A receipt ref has no tools/ tree: its blobs are scrubbed with the rules of the branch pushed with it.
    branch_commits = [rec[1] for rec in refs if not is_receipt_ref(rec[2])]
    for rec in refs:
        _, local_sha, scrub_ref, remote_sha = rec
        rules_commit = branch_commits[0] if is_receipt_ref(scrub_ref) and branch_commits else local_sha
        try:
            with tempfile.TemporaryDirectory() as tmp:
                rules_files = []
                for name in BASE_RULES:
                    rel = "tools/split/" + name
                    entry = git("ls-tree", rules_commit, "--", rel)
                    if entry.returncode:
                        raise ValueError("unavailable rules tree")
                    if entry.stdout:
                        blob = git("show", f"{rules_commit}:{rel}")
                        if blob.returncode:
                            raise ValueError("unavailable rules blob")
                        path = Path(tmp) / name
                        path.write_bytes(blob.stdout)
                        rules_files.append(str(path))
                if os.environ.get("PLANGRAPH_SCRUB_RULES"):
                    rules_files.append(os.environ["PLANGRAPH_SCRUB_RULES"])
                cfg = sc.build_config(words_file=words, rules_files=rules_files)
        except Exception as exc:
            print(f"pre-push: bad scrub config: {type(exc).__name__}: push refused",
                  file=sys.stderr)
            if isinstance(exc, ValueError) and "word list line" in str(exc):
                print(f"pre-push: {exc}", file=sys.stderr)
            return 1
        base = base_commit(remote_sha, local_sha)
        baselines = main_baselines(local_sha)
        changelog_docs_warn(base, local_sha)
        for line in git_out("diff", "--no-renames", "--name-status", base, local_sha).splitlines():
            parts = line.split("\t")
            if len(parts) != 2 or parts[0].startswith("D"):
                continue
            scan_blob(parts[1], local_sha, cfg, find_shapes, hits, baselines)
    if hits:
        sc.report(hits, words=cfg["_words"])
        print(f"pre-push: {len(hits)} scrub hit(s): push refused "
              "(rule ids above; matched values are never shown)", file=sys.stderr)
        return 1
    # Prune deleted heads too: stale tracking refs cannot vouch for parts.
    # Lane refs stop here: scrub and commit gate passed; their tests run on the train.
    refs = [rec for rec in refs if not is_lane_ref(rec[2]) and not is_receipt_ref(rec[2])]
    if not refs:
        return 0
    fetched = refresh_origin()
    for _, local_sha, remote_ref, remote_sha in refs:
        if skip_tests and remote_ref.startswith("refs/heads/land/"):
            print(f"pre-push: skipping local preflight tests for {remote_ref} (PREFLIGHT_SKIP=1)",
                  file=sys.stderr)
        batch_base = (base_commit(remote_sha, local_sha) if is_zero(remote_sha)
                      else pushed_base_commit(remote_sha, local_sha))
        with preflight_checkout(local_sha) as root:
            preflight = root / "tools/preflight.py"
            if not preflight.is_file():
                if remote_ref == "refs/heads/main":
                    print("pre-push: tools/preflight.py missing: push refused", file=sys.stderr)
                    return 1
                continue
            # Lane and train pushes run the seconds-fast checks only; the affected tests run once, in CI.
            command = [PYTHON, str(preflight),
                       "--base", affected_base_commit(remote_sha, local_sha),
                       "--scrub-base", base_commit(remote_sha, local_sha), "--head", local_sha]
            if lane_or_train_ref(remote_ref):
                command.append("--lane")
            if (os.environ.get("PREFLIGHT_FAST") == "1"
                    and remote_ref.startswith(("refs/heads/train/", "refs/heads/land/train-"))):
                command.append("--fast")
            # Git's hook-local repository variables must not redirect the worktree.
            local_env = set(git_out("rev-parse", "--local-env-vars").splitlines())
            env = {key: value for key, value in os.environ.items() if key not in local_env}
            env.pop("PREFLIGHT_TOOLS_DIR", None)
            env["PREFLIGHT_PYTHON"] = PYTHON
            env["PLANGRAPH_PUSH_RANGE"] = f"{batch_base}:{local_sha}" if fetched else ""
            # Per-check deadlines govern, including the possible INFRA retry.
            result = subprocess.run(command, cwd=root, env=env)
            if result.returncode:
                return result.returncode
    return 0


if __name__ == "__main__":
    sys.exit(main())
