#!/usr/bin/env python3
"""Pre-push gate: public scrub (D-1751) + 400-line file size (AO-400LOC, D-3198).

Runs scrub rules over committed blobs in the pushed range, including preflight;
new branches scrub from origin/main and select affected test files from their nearest remote base.
Missing preflight refuses main pushes; topic and tag pushes retain the other gates.
Preflight uses file-only local selection; suite-control smoke checks stay bounded, with full coverage in CI.
When origin/main is available, identical upstream/base blobs and inherited lines
are excluded; without it the stricter whole-file scan remains in effect.
PLANGRAPH_SCRUB_WORDS overrides ~/.config/plangraph/scrub-words.txt; an explicit
unreadable list refuses every push. Public remotes use the default (chmod 600);
if absent, warn once. remote.<name>.plangraph-private=true skips private matching.
Public patterns always run; PLANGRAPH_SCRUB_RULES adds rules. Any hit refuses (exit 1); output
is file:line and rule id only -- a matched value is never printed, nor the words-file
path. Existing tags are immutable, even when the move would fast-forward.
Install: git config core.hooksPath tools/hooks (see CONTRIBUTING.md).
"""
from __future__ import annotations

import os
import shutil
import difflib
import re
import subprocess
import sys
from pathlib import Path

PYTHON = sys.executable
TOOLS = Path(__file__).resolve().parent.parent
SPLIT = TOOLS / "split"
FILE_SIZE = TOOLS / "check_file_size.py"
CHANGELOG_DOCS = TOOLS / "check_changelog_docs.py"
sys.path.insert(0, str(SPLIT))
import scrub_check as sc  # noqa: E402

# Public allow-lists reviewed into the repo; loaded always so pushes of already
# vetted files behave like the CI tree scan.  Never a place for private words.
BASE_RULES = ("manifest.toml", "scrub_ci.toml")


def git(*args):
    return subprocess.run(["git", "--no-replace-objects", *args], capture_output=True, timeout=30)


def is_zero(oid):
    return bool(oid) and set(oid) == {"0"}


def git_out(*args):
    r = git(*args)
    return r.stdout.decode("utf-8", "replace").strip() if r.returncode == 0 else ""


def affected_base_commit(remote_sha, local_sha):
    """What the pushed commits add: the remote sha when the push fast-forwards,
    else a merge-base; a new branch uses its nearest remote merge-base, and
    with no usable base at all, everything in the pushed commits is checked."""
    if not is_zero(remote_sha) and git("cat-file", "-e", remote_sha + "^{commit}").returncode == 0:
        if git("merge-base", "--is-ancestor", remote_sha, local_sha).returncode == 0:
            return remote_sha
        mb = git_out("merge-base", remote_sha, local_sha)
        if mb:
            return mb
    else:
        best, distance = "", None
        # A stacked branch inherits its phase history. Choose the closest known
        # remote merge-base so affected tests cover only the branch's changes.
        refs = git_out("for-each-ref", "--format=%(refname)", "refs/remotes/origin").splitlines()
        refs.sort(key=lambda ref: (ref != "refs/remotes/origin/main", ref))
        for ref in refs:
            if ref.endswith("/HEAD"):
                continue
            mb = git_out("merge-base", ref, local_sha)
            count = git_out("rev-list", "--count", f"{mb}..{local_sha}") if mb else ""
            if count.isdigit() and (distance is None or int(count) < distance):
                best, distance = mb, int(count)
        if best:
            return best
    return git_out("hash-object", "-t", "tree", "--stdin")


def base_commit(remote_sha, local_sha):
    """Public scrub must cover inherited stacked history on a new remote branch."""
    if not is_zero(remote_sha):
        return affected_base_commit(remote_sha, local_sha)
    main = git_out('rev-parse', '--verify', '-q', 'refs/remotes/origin/main^{commit}')
    base = git_out('merge-base', main, local_sha) if main else ''
    return base or git_out('hash-object', '-t', 'tree', '--stdin')


def main_baselines(local_sha):
    """Only locally known upstream history can exempt inherited content."""
    main = git_out("rev-parse", "--verify", "-q", "refs/remotes/origin/main^{commit}")
    if not main:
        return []
    base = git_out("merge-base", main, local_sha)
    return list(dict.fromkeys(oid for oid in (main, base) if oid))


def scan_blob(rel, local_sha, cfg, find_shapes, hits, baselines=()):
    entry = git_out("ls-tree", local_sha, "--", rel)
    baseline_data = []
    for baseline in baselines:
        old_entry = git_out("ls-tree", baseline, "--", rel)
        if entry and entry == old_entry:
            return
        old = git("show", f"{baseline}:{rel}")
        if old.returncode == 0:
            baseline_data.append(old.stdout)
    skip = sc._allowed(rel, cfg)
    if any(w.search(rel) for w in cfg["_words"]) and "private-word" not in skip:
        pending = sc.pending_value_shas(rel, "private-word", [rel], cfg)
        if pending:
            hits.append(sc.Hit(rel, 0, "private-word", pending[0]))
    if entry.startswith("120000 "):  # a link target is a path leak, never allow-listable
        hits.append(sc.Hit(rel, 0, "symlink"))
        return
    r = git("show", f"{local_sha}:{rel}")
    if r.returncode != 0:
        return  # deleted, or a submodule gitlink
    data = r.stdout
    if b"\x00" in data[:8192]:
        return  # binary files are not scanned, same as scrub_check
    lines = data.decode("utf-8", "replace").splitlines()
    added = set(range(len(lines)))
    # Compare final trees, not commit patches: merge resolutions must be scanned
    # too. Matching blocks preserve duplicate-line counts, unlike a set of text.
    for old in baseline_data:
        matcher = difflib.SequenceMatcher(
            None, old.decode("utf-8", "replace").splitlines(), lines, autojunk=False)
        for block in matcher.get_matching_blocks():
            added.difference_update(range(block.b, block.b + block.size))
    for n, line in enumerate(lines, 1):
        if n - 1 not in added:
            continue
        for rule, vals in sorted(sc.scan_line_values(line, cfg, find_shapes).items()):
            if rule in skip:
                continue
            if sc.pending_value_shas(rel, rule, vals, cfg):
                hits.append(sc.Hit(rel, n, rule))


def file_size_gate():
    """tools/check_file_size.py on the pushing checkout: 0 clean, 1 refuse."""
    r = subprocess.run([PYTHON, str(FILE_SIZE)], capture_output=True, text=True, timeout=60)
    if r.returncode != 0:
        sys.stderr.write(r.stdout + r.stderr)
        print("pre-push: file-size gate failed: push refused (split the file, "
              "see CONTRIBUTING.md)", file=sys.stderr)
        return 1
    return 0


def changelog_docs_warn(base, head):
    """tools/check_changelog_docs.py --warn-only on base..head (the pushed sha): never refuses (D-653)."""
    if not CHANGELOG_DOCS.is_file():
        return
    r = subprocess.run(
        [PYTHON, str(CHANGELOG_DOCS), "--base", base, "--head", head, "--warn-only"],
        capture_output=True,
        text=True,
        timeout=60,
    )
    if r.stdout:
        sys.stderr.write(r.stdout)
    if r.stderr:
        sys.stderr.write(r.stderr)


def python_interpreter(root):
    """Prefer this checkout's venv, then PREFLIGHT_PYTHON, then PATH python3."""
    root = Path(root)
    for relative in ('.venv/bin/python', '.venv/Scripts/python.exe'):
        candidate = root / relative
        if candidate.is_file():
            return str(candidate.absolute())
    configured = os.environ.get('PREFLIGHT_PYTHON')
    return str(Path(configured).expanduser().absolute()) if configured else shutil.which('python3') or 'python3'


def main():
    try:
        return push_main()
    except subprocess.TimeoutExpired:
        print("pre-push: subprocess timeout: push refused", file=sys.stderr)
        return 1


def push_main():
    global PYTHON
    cargo_bin = Path.home() / '.cargo/bin'
    if cargo_bin.is_dir():
        os.environ['PATH'] = str(cargo_bin) + os.pathsep + os.environ.get('PATH', '')
    refs = [rec.split(maxsplit=3) for rec in sys.stdin.read().splitlines()]
    if not refs:
        return 0
    for rec in refs:
        if (len(rec) != 4 or
                not all(re.fullmatch(r"[0-9a-fA-F]+", rec[i]) for i in (1, 3)) or
                len(rec[1]) != len(rec[3]) or
                git("check-ref-format", rec[2]).returncode != 0):
            print("pre-push: malformed push record: push refused", file=sys.stderr)
            return 1
        _, local_sha, remote_ref, remote_sha = rec
        if is_zero(local_sha):
            print(f"pre-push: refused delete of {remote_ref}", file=sys.stderr)
            return 1
        if is_zero(remote_sha):
            continue
        if git("cat-file", "-e", remote_sha).returncode != 0:
            print(f"pre-push: remote object unavailable for {remote_ref}: push refused",
                  file=sys.stderr)
            return 1
        if local_sha == remote_sha:
            continue
        if remote_ref.startswith("refs/tags/"):
            print(f"pre-push: refused update of existing tag {remote_ref}: tags are immutable",
                  file=sys.stderr)
            return 1
        is_commit = git_out("cat-file", "-t", remote_sha) == "commit"
        if (not is_commit or git(
                "merge-base", "--is-ancestor", remote_sha, local_sha).returncode != 0):
            print(f"pre-push: refused non-fast-forward update of {remote_ref}",
                  file=sys.stderr)
            return 1
    refs = [rec for rec in refs if not is_zero(rec[1])]
    if not refs:
        return 0
    PYTHON = python_interpreter(Path(git_out("rev-parse", "--show-toplevel")))
    print(f"pre-push Python: {PYTHON}", flush=True)
    if file_size_gate():
        return 1
    explicit = "PLANGRAPH_SCRUB_WORDS" in os.environ
    words = os.environ.get("PLANGRAPH_SCRUB_WORDS") if explicit else None
    remote = sys.argv[1] if len(sys.argv) > 1 else "origin"
    private = git_out("config", "--local", "--bool", f"remote.{remote}.plangraph-private") == "true"
    rules_files = [str(SPLIT / name) for name in BASE_RULES if (SPLIT / name).is_file()]
    if os.environ.get("PLANGRAPH_SCRUB_RULES"):
        rules_files.append(os.environ["PLANGRAPH_SCRUB_RULES"])
    try:
        if explicit:
            path = Path(words)
            if not words or not path.stat().st_mode & 0o444:
                raise PermissionError
            with path.open("rb"):
                pass
        elif not private:
            path = Path.home() / ".config/plangraph/scrub-words.txt"
            try:
                mode = path.stat().st_mode
            except FileNotFoundError:
                print("pre-push: PLANGRAPH_SCRUB_WORDS unset: public patterns only, "
                      "the private-word rule is inactive", file=sys.stderr)
            else:
                if mode & 0o077:
                    print("pre-push: private list requires chmod 600: push refused", file=sys.stderr)
                    return 1
                if not mode & 0o444:
                    raise PermissionError
                words = str(path)
        if private:
            words = None
        cfg = sc.build_config(words_file=words, rules_files=rules_files)
    except Exception as exc:  # fail closed; never echo the paths
        print(f"pre-push: bad scrub config: {type(exc).__name__}: push refused",
              file=sys.stderr)
        if isinstance(exc, ValueError) and "word list line" in str(exc):
            print(f"pre-push: {exc}", file=sys.stderr)
        return 1
    find_shapes = sc._shape_finder()
    hits = []
    for rec in refs:
        _, local_sha, _, remote_sha = rec
        base = base_commit(remote_sha, local_sha)
        baselines = main_baselines(local_sha)
        changelog_docs_warn(base, local_sha)
        for line in git_out("diff", "--no-renames", "--name-status", base, local_sha).splitlines():
            parts = line.split("\t")
            if len(parts) != 2 or parts[0].startswith("D"):
                continue
            scan_blob(parts[1], local_sha, cfg, find_shapes, hits, baselines)
    if hits:
        sc.report(hits, words=cfg["_words"])
        print(f"pre-push: {len(hits)} scrub hit(s): push refused "
              "(rule ids above; matched values are never shown)", file=sys.stderr)
        return 1
    root = Path(git_out("rev-parse", "--show-toplevel"))
    preflight = root / "tools/preflight.py"
    if os.environ.get("PREFLIGHT_SKIP") != "1" and preflight.is_file():
        for _, local_sha, _, remote_sha in refs:
            command = [PYTHON, str(preflight),
                       "--base", affected_base_commit(remote_sha, local_sha),
                       "--scrub-base", base_commit(remote_sha, local_sha), "--head", local_sha]
            if os.environ.get("PREFLIGHT_FAST") == "1":
                command.append("--fast")
            # Per-check deadlines govern, including the possible INFRA retry.
            result = subprocess.run(command)
            if result.returncode:
                return result.returncode
    elif os.environ.get("PREFLIGHT_SKIP") == "1":
        print("pre-push: PREFLIGHT_SKIP=1: preflight skipped (other gates still run)",
              file=sys.stderr)
    elif any(rec[2] == "refs/heads/main" for rec in refs):
        print("pre-push: tools/preflight.py missing: push refused", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
