#!/bin/sh
# fleet-msg: thin POSIX shim for the Python bus client; forwards every argument.
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PYTHONPATH="$dir/../src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH
if command -v python3 >/dev/null 2>&1; then
  exec python3 -m plangraph.fleet_bus.client "$@"
fi
exec python -m plangraph.fleet_bus.client "$@"
