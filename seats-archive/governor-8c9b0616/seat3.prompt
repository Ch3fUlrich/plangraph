+"""Run the governor CLI as ``python -m plangraph.governor``."""
+from __future__ import annotations
+
+import sys
+
+from plangraph.governor import cli
+
+__all__ = []
+
+if __name__ == "__main__":
+    sys.exit(cli.main())
diff --git a/src/plangraph/governor/cli.py b/src/plangraph/governor/cli.py
new file mode 100644
index 00000000..1170d0ff
--- /dev/null
+++ b/src/plangraph/governor/cli.py
@@ -0,0 +1,169 @@
+"""Command line front-end for keeper metrics upload and start checks."""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+from datetime import date, datetime, timedelta, timezone
+
+from plangraph.keeper import cli_verbs
+from plangraph.governor import metrics, policy
+from plangraph.governor.keeper_source import KeeperSource, KeeperLog
+
+__all__ = ["main", "EXIT_USAGE"]
+
+EXIT_USAGE = 64
+ENV_PROJECTS = "PLANGRAPH_CLAUDE_PROJECTS_DIR"
+ENV_WEEKLY = "PLANGRAPH_WEEKLY_CAP_WEIGHTED"
+ENV_QUOTA = "PLANGRAPH_PROVIDER_QUOTA"
+
+
+def _cmd_daily(args, session) -> int:
+    """Compute and (unless dry-run) upload one day's metrics."""
+    try:
+        day = date.fromisoformat(args.date)
+    except ValueError:
+        print("bad --date", file=sys.stderr)
+        return EXIT_USAGE
+    projects_dir = args.projects_dir or os.environ.get(ENV_PROJECTS)
+    if not projects_dir:
+        print("projects dir is required", file=sys.stderr)
+        return EXIT_USAGE
+
+    weekly_cap = args.weekly_cap
+    if weekly_cap is None:
+        raw = os.environ.get(ENV_WEEKLY)
+        weekly_cap = float(raw) if raw else None
+
+    landed = {}
+    if args.repo:
+        landed = metrics.landed_by_day(
+            args.repo, day.isoformat(),
+            until=(day + timedelta(days=1)).isoformat(), ref=args.ref)
+
+    try:
+        records = metrics.iter_usage(projects_dir)
+    except OSError as exc:
+        print(f"cannot read projects dir: {exc}", file=sys.stderr)
+        return EXIT_USAGE
+
+    items = list(metrics.daily_metrics(
+        day.isoformat(), records, landed, weekly_cap))
+
+    if args.provider_usage:
+        try:
+            with open(args.provider_usage, encoding="utf-8") as fh:
+                usage = json.load(fh)
+            for provider, tokens in usage.items():
+                items.append({"metric": f"provider_used.{provider}",
+                              "value": tokens, "source": "provider-usage"})
+        except (OSError, ValueError) as exc:
+            print(f"bad provider-usage file: {exc}", file=sys.stderr)
+            return EXIT_USAGE
+
+    if args.rate_limited:
+        for provider in (p.strip() for p in args.rate_limited.split(",")):
+            if provider:
+                items.append({"metric": f"rate_limited.{provider}",
+                              "value": 1.0, "source": "operator"})
+
+    posted = False
+    if not args.dry_run:
+        try:
+            session.call("POST", "set_metrics",
+                         body={"day": day.isoformat(), "items": items})
+            posted = True
+        except cli_verbs.Unreachable:
+            return 3
+        except cli_verbs.RefusedCli as exc:
+            print(f"refused: {exc}", file=sys.stderr)
+            return 2
+
+    print(json.dumps({"day": day.isoformat(), "items": items,
+                      "posted": posted}))
+    return 0
+
+
+def _cmd_check(args, session) -> int:
+    """Run one start check and print the verdict."""
+    try:
+        now = datetime.fromisoformat(args.now) if args.now \
+            else datetime.now(timezone.utc)
+    except ValueError:
+        print("bad --now", file=sys.stderr)
+        return EXIT_USAGE
+
+    quota_text = args.quota if args.quota is not None \
+        else os.environ.get(ENV_QUOTA)
+    try:
+        quotas = policy.parse_quota(quota_text)
+    except (ValueError, TypeError):
+        print("bad --quota", file=sys.stderr)
+        return EXIT_USAGE
+
+    fallbacks = [f.strip() for f in (args.fallback or "").split(",")
+                 if f.strip()]
+
+    source = KeeperSource(session)
+    log = KeeperLog(session)
+    try:
+        decision = policy.allow(
+            args.start_kind, args.initiator, now,
+            source=source, quotas=quotas, provider=args.provider,
+            override=args.override, on_override=log,
+            fallbacks=fallbacks, on_fallback=log)
+    except (ValueError, TypeError):
+        print("bad start_kind/initiator/quota", file=sys.stderr)
+        return EXIT_USAGE
+
+    print(json.dumps({"allow": decision.allow, "reason": decision.reason,
+                      "override": decision.override,
+                      "fallback": decision.fallback,
+                      "provider": decision.provider,
+                      "burn": decision.burn}))
+    return 0 if decision.allow else 1
+
+
+def _build_parser() -> argparse.ArgumentParser:
+    """Construct the argparse tree."""
+    parser = argparse.ArgumentParser(prog="plangraph-governor")
+    sub = parser.add_subparsers(dest="command", required=True)
+
+    metrics_p = sub.add_parser("metrics")
+    metrics_sub = metrics_p.add_subparsers(dest="metrics_command",
+                                           required=True)
+    daily = metrics_sub.add_parser("daily")
+    today = datetime.now(timezone.utc).date()
+    daily.add_argument("--date",
+                       default=(today - timedelta(days=1)).isoformat())
+    daily.add_argument("--projects-dir", default=None)
+    daily.add_argument("--repo", default=None)
+    daily.add_argument("--ref", default="HEAD")
+    daily.add_argument("--weekly-cap", type=float, default=None)
+    daily.add_argument("--provider-usage", default=None)
+    daily.add_argument("--rate-limited", default=None)
+    daily.add_argument("--dry-run", action="store_true")
+
+    check = sub.add_parser("check")
+    check.add_argument("start_kind")
+    check.add_argument("initiator")
+    check.add_argument("--provider", default=None)
+    check.add_argument("--fallback", default=None)
+    check.add_argument("--quota", default=None)
+    check.add_argument("--override", default=None)
+    check.add_argument("--now", default=None)
+    return parser
+
+
+def main(argv=None, session=None) -> int:
+    """Entry point; ``session`` is injectable for tests."""
+    parser = _build_parser()
+    args = parser.parse_args(argv)
+    if session is None:
+        session = cli_verbs.Session()
+    if args.command == "metrics" and args.metrics_command == "daily":
+        return _cmd_daily(args, session)
+    if args.command == "check":
+        return _cmd_check(args, session)
+    return EXIT_USAGE
diff --git a/src/plangraph/governor/keeper_source.py b/src/plangraph/governor/keeper_source.py
new file mode 100644
index 00000000..d93e95db
--- /dev/null
+++ b/src/plangraph/governor/keeper_source.py
@@ -0,0 +1,97 @@
+"""Fail-open policy.Source and override logger backed by the keeper."""
+from __future__ import annotations
+
+from datetime import datetime, timezone
+
+__all__ = ["KeeperSource", "KeeperLog", "BURN_METRIC", "_burn_name",
+           "_quota_name", "_rate_name"]
+
+BURN_METRIC = "claude_burn_index"
+
+
+def _burn_name() -> str:
+    """Metric name for the daily burn index."""
+    return BURN_METRIC
+
+
+def _quota_name(provider: str) -> str:
+    """Metric name for a provider's used tokens."""
+    return f"provider_used.{provider}"
+
+
+def _rate_name(provider: str) -> str:
+    """Metric name for a provider's rate-limit flag."""
+    return f"rate_limited.{provider}"
+
+
+class KeeperSource:
+    """Read-only metrics source; every read fails open to ``None``."""
+
+    def __init__(self, session, today=None):
+        self.session = session
+        self._today = today or (
+            lambda: datetime.now(timezone.utc).date().isoformat())
+        self._cache: dict[tuple[str, str], list] = {}
+
+    def _rows(self, metric: str, day: str) -> list | None:
+        """Return cached ``rows`` for (metric, day) or ``None`` on any error."""
+        key = (metric, day)
+        if key in self._cache:
+            return self._cache[key]
+        try:
+            data = self.session.call("GET", "metrics",
+                                     params={"day": day, "metric": metric})
+            rows = data.get("rows")
+            if not isinstance(rows, list):
+                rows = None
+        except Exception:
+            rows = None
+        self._cache[key] = rows
+        return rows
+
+    def _first_value(self, metric: str, day: str) -> float | None:
+        """Numeric value of the first row, else ``None``."""
+        rows = self._rows(metric, day)
+        if not rows:
+            return None
+        try:
+            return float(rows[0]["value"])
+        except (KeyError, TypeError, ValueError):
+            return None
+
+    def burn(self, day: str) -> float | None:
+        """Return the burn index for ``day`` or ``None``."""
+        return self._first_value(_burn_name(), day)
+
+    def quota_used(self, provider: str, day: str) -> float | None:
+        """Return tokens used by ``provider`` for ``day`` or ``None``."""
+        return self._first_value(_quota_name(provider), day)
+
+    def rate_limited(self, provider: str) -> bool | None:
+        """True if rate-limited today, False if a zero row exists, None else."""
+        value = self._first_value(_rate_name(provider), self._today())
+        if value is None:
+            return None
+        return value >= 1.0
+
+
+class KeeperLog:
+    """Log an override/fallback to the keeper; never raise."""
+
+    def __init__(self, session):
+        self.session = session
+
+    def __call__(self, decision) -> None:
+        """POST a governor_override for ``decision``; swallow all errors."""
+        provider = decision.provider if isinstance(decision.provider, str) \
+            else None
+        body = {
+            "start_kind": decision.start_kind,
+            "initiator": decision.initiator,
+            "reason": decision.reason[:500],
+            "provider": provider,
+        }
+        try:
+            self.session.call("POST", "governor_override", body=body)
+        except Exception:
+            pass
diff --git a/src/plangraph/governor/metrics.py b/src/plangraph/governor/metrics.py
new file mode 100644
index 00000000..0542aabe
--- /dev/null
+++ b/src/plangraph/governor/metrics.py
@@ -0,0 +1,213 @@
+"""Pure computation of daily Claude usage metrics.
+
+Ported from the reference usage sampler. All configuration is passed through
+function arguments; no environment variables or home-relative paths are read.
+"""
+
+from __future__ import annotations
+
+import datetime as dt
+import glob
+import json
+import os
+import subprocess
+
+__all__ = [
+    "parse_ts",
+    "iter_usage",
+    "weighted",
+    "daily_weighted",
+    "landed_by_day",
+    "burn_index",
+    "daily_metrics",
+]
+
+
+def _as_int(v) -> int:
+    """Best-effort int coercion used while reading token fields."""
+    try:
+        return int(v or 0)
+    except (TypeError, ValueError):
+        return 0
+
+
+def parse_ts(s) -> dt.datetime | None:
+    """Parse an ISO timestamp into a UTC-aware datetime; ``Z`` and naive ok."""
+    try:
+        if not isinstance(s, str):
+            return None
+        s2 = s.strip()
+        if s2.endswith("Z"):
+            s2 = s2[:-1] + "+00:00"
+        d = dt.datetime.fromisoformat(s2)
+        if d.tzinfo is None:
+            d = d.replace(tzinfo=dt.timezone.utc)
+        return d.astimezone(dt.timezone.utc)
+    except Exception:
+        return None
+
+
+def iter_usage(projects_dir) -> list[dict]:
+    """Collect per-assistant-message usage records from JSONL transcripts.
+
+    Globs ``<projects_dir>/*/*.jsonl`` and ``<projects_dir>/*/*/subagents/*.jsonl``.
+    Only lines with ``type == "assistant"`` and a ``message.usage`` dict count.
+    Duplicates keyed on ``(message.id or uuid, requestId)`` are reduced to the
+    record with the highest total tokens. Malformed lines and files are skipped.
+    """
+    patterns = [
+        os.path.join(projects_dir, "*", "*.jsonl"),
+        os.path.join(projects_dir, "*", "*", "subagents", "*.jsonl"),
+    ]
+    best: dict[tuple, dict] = {}
+    totals: dict[tuple, int] = {}
+    for pattern in patterns:
+        for path in glob.iglob(pattern):
+            rel = os.path.relpath(path, projects_dir).replace(os.sep, "/")
+            parts = rel.split("/")
+            subagent = "/subagents/" in rel
+            if subagent:
+                session = parts[1] if len(parts) > 1 else os.path.splitext(os.path.basename(path))[0]
+            else:
+                session = os.path.splitext(parts[1])[0] if len(parts) > 1 else os.path.splitext(os.path.basename(path))[0]
+            try:
+                with open(path, "r", encoding="utf-8", errors="replace") as f:
+                    for line in f:
+                        if '"usage"' not in line or '"assistant"' not in line:
+                            continue
+                        try:
+                            d = json.loads(line)
+                        except Exception:
+                            continue
+                        if not isinstance(d, dict):
+                            continue
+                        if d.get("type") != "assistant":
+                            continue
+                        msg = d.get("message")
+                        if not isinstance(msg, dict):
+                            msg = {}
+                        usage = msg.get("usage")
+                        if not isinstance(usage, dict):
+                            continue
+                        ts = parse_ts(d.get("timestamp") or msg.get("timestamp"))
+                        if ts is None:
+                            continue
+                        input_tokens = _as_int(usage.get("input_tokens"))
+                        output_tokens = _as_int(usage.get("output_tokens"))
+                        cache_read = _as_int(usage.get("cache_read_input_tokens"))
+                        cache_write = _as_int(usage.get("cache_creation_input_tokens"))
+                        total = input_tokens + output_tokens + cache_read + cache_write
+                        key = (msg.get("id") or d.get("uuid"), d.get("requestId"))
+                        model = d.get("model") or msg.get("model") or ""
+                        rec = {
+                            "ts": ts,
+                            "session": session,
+                            "model": model,
+                            "input": input_tokens,
+                            "output": output_tokens,
+                            "cache_read": cache_read,
+                            "cache_write": cache_write,
+                        }
+                        if key not in best or total > totals[key]:
+                            best[key] = rec
+                            totals[key] = total
+            except Exception:
+                continue
+    return list(best.values())
+
+
+def weighted(rec: dict) -> float:
+    """Weighted token cost: cache reads count as one tenth."""
+    return float(rec["input"] + rec["output"] + rec["cache_write"] + 0.1 * rec["cache_read"])
+
+
+def daily_weighted(records: list[dict]) -> dict[str, float]:
+    """Sum weighted tokens grouped by UTC calendar day ``YYYY-MM-DD``."""
+    days: dict[str, float] = {}
+    for rec in records:
+        ts = rec.get("ts")
+        if not isinstance(ts, dt.datetime):
+            continue
+        day = ts.astimezone(dt.timezone.utc).strftime("%Y-%m-%d")
+        days[day] = days.get(day, 0.0) + weighted(rec)
+    return days
+
+
+def _default_runner(argv: list[str]) -> str:
+    """Run a git command and return stdout; raise on non-zero exit."""
+    return subprocess.run(argv, check=True, text=True, capture_output=True).stdout
+
+
+def landed_by_day(
+    repo_dir,
+    since: str,
+    until: str | None = None,
+    ref: str = "HEAD",
+    runner=None,
+) -> dict[str, int]:
+    """Count first-parent merge commits per UTC day from a git log.
+
+    ``since``/``until`` are ISO date strings. ``runner`` is injectable for
+    tests and takes the argv list, returning stdout. Empty dict on git failure.
+    """
+    if runner is None:
+        runner = _default_runner
+    argv = [
+        "git",
+        "-C",
+        str(repo_dir),
+        "log",
+        "--first-parent",
+        "--merges",
+        "--since=" + str(since),
+    ]
+    if until is not None:
+        argv.append("--until=" + str(until))
+    argv += ["--format=%cI", str(ref)]
+    try:
+        out = runner(argv)
+    except (OSError, subprocess.CalledProcessError):
+        return {}
+    counts: dict[str, int] = {}
+    for line in out.splitlines():
+        ts = parse_ts(line.strip())
+        if ts is None:
+            continue
+        day = ts.astimezone(dt.timezone.utc).strftime("%Y-%m-%d")
+        counts[day] = counts.get(day, 0) + 1
+    return counts
+
+
+def burn_index(day_weighted: float, weekly_cap: float | None) -> float | None:
+    """Burn ratio versus an even weekly allowance; None when cap is unusable."""
+    if weekly_cap is None or weekly_cap <= 0:
+        return None
+    return day_weighted / (weekly_cap / 7)
+
+
+def daily_metrics(
+    day: str,
+    records: list[dict],
+    landed: dict[str, int],
+    weekly_cap: float | None,
+) -> list[dict]:
+    """Build the metric rows for one UTC day."""
+    day_total = daily_weighted(records).get(day, 0.0)
+    landed_count = int(landed.get(day, 0))
+
+    rows: list[dict] = [
+        {"metric": "claude_weighted_tokens", "value": round(float(day_total), 3), "source": "transcripts"},
+    ]
+    burn = burn_index(day_total, weekly_cap)
+    if burn is not None:
+        rows.append({"metric": "claude_burn_index", "value": round(burn, 3), "source": "transcripts"})
+    rows.append({"metric": "landed_changes", "value": round(float(landed_count), 3), "source": "git"})
+    if landed_count > 0:
+        rows.append(
+            {
+                "metric": "weighted_tokens_per_landed",
+                "value": round(day_total / landed_count, 3),
+                "source": "derived",
+            }
+        )
+    return rows
diff --git a/src/plangraph/governor/policy.py b/src/plangraph/governor/policy.py
new file mode 100644
index 00000000..f9c51833
--- /dev/null
+++ b/src/plangraph/governor/policy.py
@@ -0,0 +1,277 @@
+"""Budget governor: decide whether a run may start based on burn and quota.
+
+Pure and hermetic: every decision comes from the injected ``Source`` and the
+caller-supplied clock. Unknown data fails OPEN (allow) so the governor never
+strands a run on a data gap. It NEVER blocks answering questions, an
+operator-initiated session, or an operator-requested judge. ``None`` is used as
+the "no override" sentinel; a blank/whitespace override string is ignored.
+
+Operator D-1533: orchestration works with any model family, Claude is only one
+leg. When a Claude-only gate (burn/rate-limit) would block an agent planner,
+expert or judge, the governor first tries the caller-supplied ``fallbacks`` for a
+usable non-Claude leg and logs the substitution; only if none is usable does the
+deny stand (so overrides can still apply on top of it).
+"""
+from __future__ import annotations
+
+from collections.abc import Mapping, Sequence
+from dataclasses import dataclass, field, replace
+from datetime import datetime, timezone
+from typing import Protocol
+
+__all__ = [
+    "START_KINDS",
+    "INITIATORS",
+    "BURN_LIMIT",
+    "CLAUDE",
+    "Decision",
+    "Source",
+    "StaticSource",
+    "parse_quota",
+    "allow",
+]
+
+START_KINDS = ("planner", "expert", "judge", "answer", "worker_leg")
+INITIATORS = ("operator", "agent")
+BURN_LIMIT = 1.0  # burn is weighted-tokens / (weekly-cap / 7); 1.0 is the gate.
+CLAUDE = "claude"  # the single leg the burn gate guards; fallbacks avoid it.
+
+# planner / expert / judge share the burn gate; these are the kinds that may fall
+# back to another leg. Worker legs are chosen by the router and never fall back.
+_FALLBACK_KINDS = ("planner", "expert", "judge")
+
+
+@dataclass(frozen=True)
+class Decision:
+    """Immutable verdict for one start request.
+
+    Trailing fields carry defaults so the documented field order is valid.
+    """
+
+    allow: bool
+    reason: str
+    override: bool = False
+    start_kind: str = ""
+    initiator: str = ""
+    provider: str | None = None
+    burn: float | None = None
+    fallback: str | None = None
+
+    def as_tuple(self) -> tuple[bool, str]:
+        """Return ``(allow, reason)`` only."""
+        return (self.allow, self.reason)
+
+
+class Source(Protocol):
+    """Day is a UTC ``YYYY-MM-DD`` string."""
+
+    def burn(self, day: str) -> float | None: ...
+
+    def quota_used(self, provider: str, day: str) -> float | None: ...
+
+    def rate_limited(self, provider: str) -> bool | None: ...
+
+
+@dataclass(frozen=True)
+class StaticSource:
+    """In-memory ``Source`` for tests and the CLI.
+
+    ``rate_limited`` is the set of currently throttled providers; it is the
+    optional surface the governor reads back for the burn/fallback logic.
+    """
+
+    burn_by_day: Mapping[str, float | None] = field(default_factory=dict)
+    used: Mapping[tuple[str, str], float | None] = field(default_factory=dict)
+    rate_limited: frozenset = frozenset()
+
+    def burn(self, day: str) -> float | None:
+        return self.burn_by_day.get(day)
+
+    def quota_used(self, provider: str, day: str) -> float | None:
+        return self.used.get((provider, day))
+
+
+def parse_quota(text: str | None) -> dict[str, float]:
+    """Parse ``"a=100,b=2.5e6"`` to ``{"a": 100.0, "b": 2500000.0}``.
+
+    Empty/None input yields ``{}``; a malformed pair or a negative value raises.
+    """
+    if text is None or not text.strip():
+        return {}
+    result: dict[str, float] = {}
+    for pair in text.split(","):
+        key, sep, value = pair.partition("=")
+        if not sep:
+            raise ValueError(f"malformed quota pair: {pair!r}")
+        key = key.strip()
+        value = value.strip()
+        if not key:
+            raise ValueError(f"malformed quota pair: {pair!r}")
+        try:
+            number = float(value)
+        except ValueError:
+            raise ValueError(f"malformed quota value: {pair!r}") from None
+        if number < 0:
+            raise ValueError(f"negative quota: {pair!r}")
+        result[key] = number
+    return result
+
+
+def _utc_day(now: datetime) -> str:
+    """Normalize an aware or naive datetime to its UTC calendar day (naive = UTC)."""
+    if now.tzinfo is None:
+        return now.date().isoformat()
+    return now.astimezone(timezone.utc).date().isoformat()
+
+
+def _rate_limited(source: Source, provider: str) -> bool | None:
+    """Whether ``provider`` is throttled: True only for a definite signal.
+
+    Protocol sources expose a callable ``rate_limited``; ``StaticSource`` instead
+    carries the throttled providers as a frozenset, so the same accessor works for
+    either without forcing a method onto the in-memory source.
+    """
+    attr = getattr(source, "rate_limited", None)
+    if attr is None:
+        return None
+    if callable(attr):
+        return attr(provider)
+    return provider in attr
+
+
+def _usable_fallback(p: str, day: str, source: Source, quotas: Mapping[str, float] | None) -> bool:
+    """A non-Claude fallback leg is usable when not throttled and within quota."""
+    if p == CLAUDE:
+        return False
+    if _rate_limited(source, p) is True:
+        return False
+    limit = (quotas or {}).get(p)
+    if limit is None:
+        return True
+    used = source.quota_used(p, day)
+    return used is None or used < limit
+
+
+def _pick_fallback(
+    fallbacks: Sequence[str], day: str, source: Source, quotas: Mapping[str, float] | None
+) -> str | None:
+    """First provider in ``fallbacks`` that is a usable non-Claude leg, else None."""
+    for p in fallbacks:
+        if _usable_fallback(p, day, source, quotas):
+            return p
+    return None
+
+
+def _decide(
+    start_kind: str,
+    initiator: str,
+    now: datetime,
+    source: Source,
+    quotas: Mapping[str, float] | None,
+    provider: str | None,
+) -> Decision:
+    """Produce the base verdict (never a fallback, never an override)."""
+    if start_kind not in START_KINDS:
+        raise ValueError(f"unknown start_kind: {start_kind!r}")
+    if initiator not in INITIATORS:
+        raise ValueError(f"unknown initiator: {initiator!r}")
+
+    day = _utc_day(now)
+    ctx = {"start_kind": start_kind, "initiator": initiator, "provider": provider}
+
+    # Operator-initiated is never blocked, for any kind.
+    if initiator == "operator":
+        return Decision(allow=True, reason="operator_initiated", burn=None, **ctx)
+    # Answering is never blocked, for any initiator.
+    if start_kind == "answer":
+        return Decision(allow=True, reason="answer_always", burn=None, **ctx)
+
+    # Remaining paths are agent-initiated.
+    if start_kind == "worker_leg":
+        if provider is None:
+            raise ValueError("provider is required for worker_leg")
+        if _rate_limited(source, provider) is True:
+            reason = f"provider_rate_limited (provider={provider})"
+            return Decision(allow=False, reason=reason, burn=None, **ctx)
+        limit = (quotas or {}).get(provider)
+        if limit is None:
+            return Decision(allow=True, reason="no_quota_configured", burn=None, **ctx)
+        used = source.quota_used(provider, day)
+        if used is None:
+            return Decision(allow=True, reason="quota_unknown", burn=None, **ctx)
+        if used >= limit:
+            reason = f"provider_quota_exhausted (used={used:.2f},limit={limit:.2f})"
+            return Decision(allow=False, reason=reason, burn=None, **ctx)
+        return Decision(allow=True, reason="quota_ok", burn=None, **ctx)
+
+    # planner / expert / judge share the Claude burn gate; judge is not privileged.
+    # A block here is a Claude-only limitation, so allow() retries it on a fallback.
+    burn = source.burn(day)
+    blocked: str | None = None
+    if burn is not None and burn > BURN_LIMIT:
+        blocked = f"claude_burn_over_1_7 (burn={burn:.2f})"
+    elif _rate_limited(source, CLAUDE) is True:
+        blocked = "claude_rate_limited"
+    if blocked is not None:
+        return Decision(allow=False, reason=blocked, burn=burn, **ctx)
+    if burn is None:
+        return Decision(allow=True, reason="burn_unknown", burn=None, **ctx)
+    return Decision(allow=True, reason="burn_ok", burn=burn, **ctx)
+
+
+def allow(
+    start_kind: str,
+    initiator: str,
+    now: datetime,
+    *,
+    source: Source,
+    quotas: Mapping[str, float] | None = None,
+    provider: str | None = None,
+    override: str | None = None,
+    on_override=None,
+    fallbacks: Sequence[str] = (),
+    on_fallback=None,
+) -> Decision:
+    """Return a ``Decision`` for whether ``start_kind`` may start right now.
+
+    ``now`` may be timezone-aware or naive (treated as UTC). A blocked agent
+    planner/expert/judge first tries the non-Claude ``fallbacks`` (logging once via
+    ``on_fallback``); if none is usable the deny stands. ``override`` is a non-empty
+    reason that flips a (fallback-less) deny into an allow (logged once via
+    ``on_override``); an allow base ignores it.
+    """
+    base = _decide(start_kind, initiator, now, source, quotas, provider)
+
+    if (
+        not base.allow
+        and base.initiator == "agent"
+        and base.start_kind in _FALLBACK_KINDS
+    ):
+        leg = _pick_fallback(fallbacks, _utc_day(now), source, quotas)
+        if leg is not None:
+            d = Decision(
+                allow=True,
+                reason=f"fallback: {leg} ({base.reason})",
+                start_kind=base.start_kind,
+                initiator=base.initiator,
+                provider=leg,
+                burn=base.burn,
+                fallback=leg,
+            )
+            if on_fallback is not None:
+                try:
+                    on_fallback(d)  # a logging failure must never block the start.
+                except Exception:
+                    pass
+            return d
+
+    text = override.strip() if override else ""
+    if base.allow or not text:
+        return base
+    final = replace(base, allow=True, reason=f"override: {text}", override=True)
+    if on_override is not None:
+        try:
+            on_override(final)  # exceptions must never block the start itself.
+        except Exception:
+            pass
+    return final
